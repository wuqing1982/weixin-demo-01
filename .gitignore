__pycache__/
*.pyc
.codex/
.env
*.env

# User-generated assets (images, audio, uploads)
assets/generated/
assets/uploads/
assets/audio/
assets/video_exports/

# Design screenshots (not needed in repo or mini program package)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.mp3
*.wav
# Exceptions: keep mini program UI icons/assets that ARE needed
!components/**/*.png
!components/**/*.jpg
!pages/**/*.png
!pages/**/*.jpg
!assets/icons/

# Storage config (contains cloud credentials)
backend/data/storage_config.json

# Playwright MCP logs
.playwright-mcp/

# Database backups
backup_*.sql
