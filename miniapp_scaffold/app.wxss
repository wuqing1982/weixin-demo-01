page {
  min-height: 100%;
  background: linear-gradient(180deg, #0b0b0c 0%, #121318 100%);
  color: #ffffff;
  font-family: Arial, sans-serif;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
}

.card {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 0;
  background: linear-gradient(135deg, #667eea, #7c5cd6);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary::after,
.btn-secondary::after,
.btn-ghost::after {
  border: 0;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 28rpx;
}
