<view class="container">
  <text class="section-title">我的导出视频</text>
  <text class="section-subtitle">已完成的视频导出，点击即可播放。</text>

  <view wx:if="{{loading}}" class="state-card">加载视频中...</view>

  <view wx:elif="{{errorMessage}}" class="state-card">{{errorMessage}}</view>

  <view wx:elif="{{!videos.length}}" class="state-card">还没有导出过视频，去场景页面导出一个试试。</view>

  <view wx:else class="video-list">
    <view
      wx:for="{{videos}}"
      wx:key="jobId"
      class="video-card card"
      bindtap="onPlayVideo"
      data-index="{{index}}"
    >
      <view class="video-cover-wrap">
        <image class="video-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="play-icon">
          <view class="play-triangle"></view>
        </view>
      </view>
      <view class="video-meta">
        <text class="video-title">{{item.sceneTitle || '未命名场景'}}</text>
        <text class="video-date">{{item.completedAt}}</text>
      </view>
    </view>
  </view>
</view>
