.video-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.video-card {
  overflow: hidden;
}

.video-cover-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.video-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  /* dark */
  background: rgba(0,0,0,0.50) !important;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Light: darker overlay */

/* Ocean: blue-tinted overlay */

.play-triangle {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 16rpx 0 16rpx 28rpx;
  border-color: transparent transparent transparent #fff !important;
  margin-left: 6rpx;
}

.video-meta {
  padding: 24rpx;
}

.video-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.video-date {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  /* dark */
  color: rgba(255,255,255,0.60) !important;
}

/* Notion */
.play-icon.theme-notion { background: rgba(0,0,0,0.40) !important; }
.video-date.theme-notion { color: #a39e98 !important; }
