<view class="container product-page">
  <view class="summary-card card">
    <text class="section-title">会员套餐</text>
    <text class="section-subtitle">购买套餐解锁全部场景和生成功能，积分可叠加。</text>
    <view class="summary-grid" wx:if="{{me}}">
      <view class="summary-pill">
        <text class="summary-label">会员状态</text>
        <text class="summary-value {{me.memberSummary.isActive ? 'active' : 'inactive'}}">{{me.memberSummary.isActive ? '已开通' : '未开通'}}</text>
      </view>
      <view class="summary-pill">
        <text class="summary-label">剩余积分</text>
        <text class="summary-value">{{me.creditSummary.sceneGenerateBalance || 0}}</text>
      </view>
      <view class="summary-pill" wx:if="{{me.memberSummary.isActive && me.memberSummary.expiresAt}}">
        <text class="summary-label">到期时间</text>
        <text class="summary-value expires">{{me.memberSummary.expiresAt}}</text>
      </view>
    </view>
    <view wx:elif="{{guestMode}}" class="guest-tip">
      <text class="guest-tip-title">游客浏览中</text>
      <text class="guest-tip-desc">可以先看会员套餐，真正下单前再用微信一键登录。</text>
    </view>
    <button class="btn-secondary orders-btn" bindtap="onOpenOrders">查看我的订单</button>
  </view>

  <view wx:if="{{loading}}" class="state-card">商品加载中...</view>
  <view wx:elif="{{errorMessage}}" class="state-card">{{errorMessage}}</view>

  <view wx:else class="tier-list">
    <view wx:for="{{tierCards}}" wx:key="skuId" class="tier-card card {{item.recommended ? 'tier-recommended' : ''}} {{item.isCurrent ? 'tier-current' : ''}}">
      <view wx:if="{{item.recommended}}" class="tier-badge">推荐</view>
      <view wx:if="{{item.isCurrent}}" class="tier-badge badge-current">当前</view>
      <text class="tier-name">{{item.name}}</text>
      <view class="tier-price-row">
        <text class="tier-price">¥{{item.salePrice}}</text>
        <text class="tier-original">¥{{item.listPrice}}</text>
      </view>
      <view class="tier-features">
        <view class="tier-feature">
          <text class="feature-icon credits-icon">◆</text>
          <text class="feature-text">{{item.credits}} 次场景生成积分</text>
        </view>
        <view class="tier-feature">
          <text class="feature-icon {{item.videoExport ? 'check-icon' : 'cross-icon'}}">{{item.videoExport ? '✓' : '✕'}}</text>
          <text class="feature-text">视频导出{{item.videoExport ? '（保留3小时）' : ''}}</text>
        </view>
        <view class="tier-feature">
          <text class="feature-icon check-icon">✓</text>
          <text class="feature-text">全部公开场景</text>
        </view>
        <view class="tier-feature" wx:if="{{item.priorityQueue}}">
          <text class="feature-icon check-icon">✓</text>
          <text class="feature-text">优先生成队列</text>
        </view>
      </view>
      <button
        class="btn-primary buy-btn {{item.isCurrent ? 'btn-disabled' : ''}}"
        loading="{{payingSkuId === item.skuId}}"
        disabled="{{payingSkuId && payingSkuId !== item.skuId}}"
        bindtap="onBuySku"
        data-sku-id="{{item.skuId}}"
      >
        {{item.isCurrent ? '当前套餐' : (guestMode ? '登录后购买' : '立即购买')}}
      </button>
    </view>
  </view>
</view>
