<view class="page-root theme-{{theme}}">
<view class="container product-page">
  <view class="summary-card card theme-{{theme}}">
    <text class="section-title theme-{{theme}}">会员套餐</text>
    <text class="section-subtitle theme-{{theme}}">购买套餐解锁全部场景和生成功能，积分可叠加。</text>
    <view class="summary-grid" wx:if="{{me}}">
      <view class="summary-pill theme-{{theme}} {{me.memberSummary.isActive ? 'pill-active' : ''}}">
        <text class="summary-label theme-{{theme}}">当前订阅</text>
        <text class="summary-value theme-{{theme}} {{me.memberSummary.isActive ? 'active' : 'inactive'}}">{{memberTierLabel}}</text>
      </view>
      <view class="summary-pill theme-{{theme}}">
        <text class="summary-label theme-{{theme}}">剩余积分</text>
        <text class="summary-value theme-{{theme}}">{{me.creditSummary.sceneGenerateBalance || 0}}</text>
      </view>
      <view class="summary-pill theme-{{theme}}" wx:if="{{me.memberSummary.isActive && me.memberSummary.expiresAt}}">
        <text class="summary-label theme-{{theme}}">到期时间</text>
        <text class="summary-value theme-{{theme}} expires">{{me.memberSummary.expiresAt}}</text>
      </view>
    </view>
    <view wx:elif="{{guestMode}}" class="guest-tip theme-{{theme}}">
      <text class="guest-tip-title theme-{{theme}}">游客浏览中</text>
      <text class="guest-tip-desc theme-{{theme}}">可以先看会员套餐，真正下单前再用微信一键登录。</text>
    </view>
    <button class="btn-secondary theme-{{theme}} orders-btn" bindtap="onOpenOrders">查看我的订单</button>
    <view class="cdk-actions-row">
      <button class="btn-cdk theme-{{theme}}" bindtap="onOpenCdkModal">卡密兑换</button>
      <button class="btn-cdk-record theme-{{theme}}" bindtap="onOpenCdkRecords">兑换记录</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card theme-{{theme}}">商品加载中...</view>
  <view wx:elif="{{errorMessage}}" class="state-card theme-{{theme}}">{{errorMessage}}</view>

  <view wx:else class="tier-list">
    <view wx:for="{{tierCards}}" wx:key="skuId" class="tier-card card theme-{{theme}} {{item.recommended ? 'tier-recommended theme-{{theme}}' : ''}} {{item.isCurrent ? 'tier-current theme-{{theme}}' : ''}}">
      <view wx:if="{{item.recommended}}" class="tier-badge">推荐</view>
      <view wx:if="{{item.isCurrent}}" class="tier-badge badge-current theme-{{theme}}">当前</view>
      <text class="tier-name">{{item.name}}</text>
      <view class="tier-price-row">
        <text class="tier-price theme-{{theme}}">¥{{item.salePrice}}</text>
        <text class="tier-original theme-{{theme}}">¥{{item.listPrice}}</text>
      </view>
      <view class="tier-features">
        <view class="tier-feature">
          <text class="feature-icon check-icon theme-{{theme}}">✓</text>
          <text class="feature-text theme-{{theme}}">年度会员（365天）</text>
        </view>
        <view class="tier-feature">
          <text class="feature-icon credits-icon theme-{{theme}}">◆</text>
          <text class="feature-text theme-{{theme}}">{{item.credits}} 次场景生成积分</text>
        </view>
        <view class="tier-feature">
          <text class="feature-icon theme-{{theme}} {{item.videoExport ? 'check-icon' : 'cross-icon'}}">{{item.videoExport ? '✓' : '✕'}}</text>
          <text class="feature-text theme-{{theme}}" wx:if="{{item.tierCode === 'plus'}}">150个视频导出（自己拍摄上传创建）</text>
          <text class="feature-text theme-{{theme}}" wx:elif="{{item.tierCode === 'max'}}">500个视频导出（自己拍摄上传创建）</text>
          <text class="feature-text theme-{{theme}}" wx:else>视频导出</text>
        </view>
        <view class="tier-feature">
          <text class="feature-icon check-icon theme-{{theme}}">✓</text>
          <text class="feature-text theme-{{theme}}">全部公开场景</text>
        </view>
        <view class="tier-feature" wx:if="{{item.priorityQueue}}">
          <text class="feature-icon check-icon theme-{{theme}}">✓</text>
          <text class="feature-text theme-{{theme}}">优先生成队列</text>
        </view>
      </view>
      <view wx:if="{{item.upgradeHint}}" class="upgrade-hint theme-{{theme}}">
        <text class="upgrade-hint-text theme-{{theme}}">{{item.upgradeHint}}</text>
      </view>
      <button
        class="btn-primary theme-{{theme}} buy-btn {{!item.canPurchase || (item.isCurrent && item.purchaseAction !== 'renew') ? 'btn-disabled' : ''}}"
        loading="{{payingSkuId === item.skuId}}"
        disabled="{{!item.canPurchase || (payingSkuId && payingSkuId !== item.skuId)}}"
        bindtap="onBuySku"
        data-sku-id="{{item.skuId}}"
      >
        {{guestMode ? '登录后购买' : (item.purchaseAction === 'renew' ? '续费' : (item.purchaseAction === 'upgrade' ? '升级至' + item.name : (item.purchaseAction === 'blocked' ? '当前等级更高' : '立即购买')))}}
      </button>
    </view>
  </view>

  <!-- CDK redeem modal -->
  <view class="cdk-modal-mask" wx:if="{{showCdkModal}}" bindtap="onCloseCdkModal">
    <view class="cdk-modal theme-{{theme}}" catchtap="">
      <text class="cdk-modal-title theme-{{theme}}">卡密兑换</text>
      <view class="cdk-input-wrap theme-{{theme}}">
        <input
          class="cdk-input theme-{{theme}}"
          placeholder="请输入卡密码，如 PLUS-A1B2-C3D4-E5F6-G7H8"
          placeholder-class="cdk-placeholder theme-{{theme}}"
          value="{{cdkInput}}"
          bindinput="onCdkInput"
          maxlength="27"
          always-embed
          adjust-position="{{false}}"
        />
      </view>
      <view class="cdk-modal-actions">
        <button class="btn-secondary theme-{{theme}} cdk-cancel-btn" bindtap="onCloseCdkModal">取消</button>
        <button class="btn-primary theme-{{theme}} cdk-confirm-btn" loading="{{cdkRedeeming}}" disabled="{{cdkRedeeming || !cdkInput}}" bindtap="onRedeemCdk">确认兑换</button>
      </view>
    </view>
  </view>
</view>
</view>
