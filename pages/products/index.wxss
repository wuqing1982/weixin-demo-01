.product-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.summary-pill {
  flex: 1;
  min-width: 140rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  /* dark: glass */
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
}

/* Light: white card */

/* Ocean: blue ice */

/* Active subscription pill highlight */
.pill-active {
  border-color: rgba(74, 222, 128, 0.40) !important;
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.10), rgba(74, 222, 128, 0.04)) !important;
}

.guest-tip {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 244, 219, 0.08) !important;
  border: 1px solid rgba(255, 227, 173, 0.16) !important;
}

.summary-label,
.product-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.60) !important;
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.summary-value.active {
  color: #4ade80 !important;
}

.summary-value.inactive {
  color: rgba(255,255,255,0.40) !important;
}

.summary-value.expires {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.40) !important;
}

.guest-tip-title,
.guest-tip-desc {
  display: block;
}

.guest-tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe7a8 !important;
}

.guest-tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.60) !important;
}

.orders-btn {
  margin-top: 24rpx;
}

/* --- Tier Cards --- */

.tier-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tier-card {
  position: relative;
  padding: 32rpx;
  /* dark */
  border: 1px solid rgba(255,255,255,0.12) !important;
}

/* Light: solid white */

/* Ocean: blue border */

.tier-recommended {
  border-color: rgba(250, 204, 21, 0.40) !important;
  background: linear-gradient(135deg, rgba(250, 204, 21, 0.06), transparent 60%) !important;
}

.tier-current {
  border-color: rgba(74, 222, 128, 0.40) !important;
}

.tier-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: #facc15 !important;
  color: #1a1a1a !important;
  font-size: 22rpx;
  font-weight: 700;
}

.badge-current {
  background: #4ade80 !important;
  color: #1a1a1a !important;
}

.tier-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.tier-price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tier-price {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffe7a8 !important;
}

.tier-original {
  font-size: 26rpx;
  text-decoration: line-through;
  color: rgba(255,255,255,0.40) !important;
}

.tier-features {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tier-feature {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-icon {
  font-size: 24rpx;
  width: 36rpx;
  text-align: center;
}

.credits-icon {
  color: #667eea !important;
}

.check-icon {
  color: #4ade80 !important;
}

.cross-icon {
  color: rgba(255, 255, 255, 0.25) !important;
}

.feature-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.80) !important;
}

.buy-btn {
  width: 100%;
  margin-top: 28rpx;
}

.btn-disabled {
  opacity: 0.35;
}

/* --- Upgrade Hint --- */
.upgrade-hint {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(250, 204, 21, 0.08) !important;
  border: 1px solid rgba(250, 204, 21, 0.18) !important;
}

.upgrade-hint-text {
  font-size: 22rpx;
  color: #facc15 !important;
}

/* --- CDK Buttons Row --- */
.cdk-actions-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-cdk {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: rgba(102, 126, 234, 0.12) !important;
  color: #667eea !important;
  border: 1px solid rgba(102, 126, 234, 0.25) !important;
}

.btn-cdk-record {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: rgba(74, 222, 128, 0.10) !important;
  color: #4ade80 !important;
  border: 1px solid rgba(74, 222, 128, 0.22) !important;
}

/* --- CDK Modal --- */
.cdk-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.cdk-modal {
  width: 85%;
  max-width: 680rpx;
  padding: 48rpx;
  border-radius: 24rpx;
  background: #1a1a2e !important;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.cdk-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 30rpx;
  color: #ffffff !important;
}

/* Visible fake field; the real native input is kept to a 1rpx keyboard sink. */
.cdk-input-wrap {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  padding: 14rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  overflow: hidden;
}

.cdk-input-focused {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.25);
}

.cdk-input-display {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.cdk-input-value,
.cdk-input-placeholder {
  display: block;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 100%;
  font-size: 30rpx;
  line-height: 72rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cdk-input-value {
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.cdk-input-placeholder {
  color: rgba(255, 255, 255, 0.35) !important;
}

.cdk-input-caret {
  width: 3rpx;
  height: 36rpx;
  margin-left: 6rpx;
  border-radius: 2rpx;
  background: #667eea;
  flex-shrink: 0;
  animation: cdk-caret-blink 1s steps(2, start) infinite;
}

/* ================================================================
   Notion overrides — page-specific
   ================================================================ */

/* Summary pill */
.summary-pill.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  border-radius: 16rpx !important;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04), 0 1rpx 4rpx rgba(0,0,0,0.02) !important;
}

/* Active subscription pill */
.pill-active.theme-notion {
  border-color: #1aae39 !important;
  background: rgba(26,174,57,0.06) !important;
}

/* Guest tip */
.guest-tip.theme-notion {
  background: rgba(221,91,0,0.06) !important;
  border: 1px solid rgba(221,91,0,0.15) !important;
  border-radius: 16rpx !important;
}

/* Summary label / product subtitle */
.summary-label.theme-notion,
.product-subtitle.theme-notion { color: #a39e98 !important; }

/* Summary value states */
.summary-value.active.theme-notion { color: #1aae39 !important; }
.summary-value.inactive.theme-notion { color: #a39e98 !important; }
.summary-value.expires.theme-notion { color: #a39e98 !important; }

/* Guest tip text */
.guest-tip-title.theme-notion { color: #dd5b00 !important; }
.guest-tip-desc.theme-notion { color: #615d59 !important; }

/* Tier card */
.tier-card.theme-notion {
  border-color: rgba(0,0,0,0.1) !important;
}

/* Recommended tier */
.tier-recommended.theme-notion {
  background: linear-gradient(135deg, rgba(0,117,222,0.06), transparent 60%) !important;
  border-color: #0075de !important;
}

/* Current tier */
.tier-current.theme-notion {
  border-color: #1aae39 !important;
}

/* Badge current */
.badge-current.theme-notion { background: #1aae39 !important; color: #ffffff !important; }

/* Tier price */
.tier-price.theme-notion { color: #0075de !important; }

/* Tier original price */
.tier-original.theme-notion { color: #a39e98 !important; }

/* Feature icons */
.credits-icon.theme-notion { color: #0075de !important; }
.check-icon.theme-notion { color: #1aae39 !important; }
.cross-icon.theme-notion { color: #dddddd !important; }

/* Feature text */
.feature-text.theme-notion { color: rgba(0,0,0,0.95) !important; }

/* Upgrade hint */
.upgrade-hint.theme-notion {
  background: rgba(0,117,222,0.06) !important;
  border-color: rgba(0,117,222,0.15) !important;
}
.upgrade-hint-text.theme-notion { color: #0075de !important; }

/* CDK button */
.btn-cdk.theme-notion {
  background: rgba(0,117,222,0.08) !important;
  color: #0075de !important;
  border: 1px solid rgba(0,117,222,0.20) !important;
}

/* CDK record button */
.btn-cdk-record.theme-notion {
  background: rgba(26,174,57,0.08) !important;
  color: #1aae39 !important;
  border: 1px solid rgba(26,174,57,0.18) !important;
}

/* CDK modal */
.cdk-modal.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.10);
}
.cdk-modal-title.theme-notion { color: rgba(0,0,0,0.95) !important; }

/* CDK input */
.cdk-input-wrap.theme-notion {
  border-color: #dddddd;
  background: #f6f5f4;
}
.cdk-input-focused.theme-notion {
  border-color: #0075de;
  box-shadow: 0 0 0 4rpx rgba(0,117,222,0.15);
}
.cdk-input-value.theme-notion { color: rgba(0,0,0,0.95); }
.cdk-input-placeholder.theme-notion { color: #a39e98 !important; }
.cdk-input-caret.theme-notion { background: #0075de; }

@keyframes cdk-caret-blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.cdk-native-input {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  z-index: 0;
  width: 1rpx;
  min-width: 1rpx;
  height: 1rpx;
  min-height: 1rpx;
  line-height: 1rpx;
  opacity: 0;
  color: transparent;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
}

.cdk-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.cdk-cancel-btn,
.cdk-confirm-btn {
  flex: 1;
  margin: 0;
}
