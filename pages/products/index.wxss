.product-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.summary-pill {
  flex: 1;
  min-width: 140rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: var(--color-surface);
  border: 1px solid var(--color-surface-border);
}

.guest-tip {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: var(--color-surface);
  border: 1px solid var(--color-surface-border);
}

.summary-label,
.product-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.summary-value.active {
  color: var(--color-success);
}

.summary-value.inactive {
  color: var(--color-text-weak);
}

.summary-value.expires {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-text-weak);
}

.guest-tip-title,
.guest-tip-desc {
  display: block;
}

.guest-tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-warning);
}

.guest-tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.orders-btn {
  margin-top: 24rpx;
}

/* --- Tier Cards --- */

.tier-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tier-card {
  position: relative;
  padding: 32rpx;
  border: 1px solid var(--color-surface-border);
}

.tier-recommended {
  border-color: var(--color-warning);
  background: linear-gradient(135deg, var(--color-surface), transparent 60%);
}

.tier-current {
  border-color: var(--color-success);
}

.tier-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: var(--color-warning);
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 700;
}

.badge-current {
  background: var(--color-success);
}

.tier-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.tier-price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tier-price {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-warning);
}

.tier-original {
  font-size: 26rpx;
  color: var(--color-text-weak);
  text-decoration: line-through;
}

.tier-features {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tier-feature {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-icon {
  font-size: 24rpx;
  width: 36rpx;
  text-align: center;
}

.credits-icon {
  color: var(--color-primary);
}

.check-icon {
  color: var(--color-success);
}

.cross-icon {
  color: var(--color-text-weak);
}

.feature-text {
  font-size: 26rpx;
  color: var(--color-text);
}

.buy-btn {
  width: 100%;
  margin-top: 28rpx;
}

.btn-disabled {
  opacity: 0.5;
}
