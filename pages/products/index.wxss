.product-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.summary-pill {
  flex: 1;
  min-width: 140rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  /* dark */
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
}
.theme-light .summary-pill {
  background: #ffffff;
  border: 1px solid #e0e0e0;
}
.theme-ocean .summary-pill {
  background: rgba(100,180,255,0.08);
  border: 1px solid rgba(100,180,255,0.18);
}

.guest-tip {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 244, 219, 0.08);
  border: 1px solid rgba(255, 227, 173, 0.16);
}

.summary-label,
.product-subtitle {
  display: block;
  font-size: 24rpx;
}
/* dark */
.summary-label,
.product-subtitle { color: rgba(255,255,255,0.72); }
.theme-light .summary-label,
.theme-light .product-subtitle { color: #666666; }
.theme-ocean .summary-label,
.theme-ocean .product-subtitle { color: rgba(227,242,253,0.70); }

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.summary-value.active {
  color: #4ade80;
}
.theme-light .summary-value.active { color: #07c160; }
.theme-ocean .summary-value.active { color: #4dd0e1; }

.summary-value.inactive {
  color: rgba(255,255,255,0.50);
}
.theme-light .summary-value.inactive { color: #999999; }
.theme-ocean .summary-value.inactive { color: rgba(227,242,253,0.45); }

.summary-value.expires {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.50);
}
.theme-light .summary-value.expires { color: #999999; }
.theme-ocean .summary-value.expires { color: rgba(227,242,253,0.45); }

.guest-tip-title,
.guest-tip-desc {
  display: block;
}

.guest-tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe7a8;
}

.theme-light .guest-tip-title {
  color: #d48806;
}

.theme-ocean .guest-tip-title {
  color: #ffd54f;
}

.guest-tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.72);
}
.theme-light .guest-tip-desc { color: #666666; }
.theme-ocean .guest-tip-desc { color: rgba(227,242,253,0.70); }

.orders-btn {
  margin-top: 24rpx;
}

/* --- Tier Cards --- */

.tier-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tier-card {
  position: relative;
  padding: 32rpx;
  border: 1px solid rgba(255,255,255,0.14);
}
.theme-light .tier-card {
  border-color: #e0e0e0;
}
.theme-ocean .tier-card {
  border-color: rgba(100,180,255,0.18);
}

.tier-recommended {
  border-color: rgba(250, 204, 21, 0.4);
  background: linear-gradient(135deg, rgba(250, 204, 21, 0.06), transparent 60%);
}

.tier-current {
  border-color: rgba(74, 222, 128, 0.4);
}

.tier-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: #facc15;
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 700;
}

.badge-current {
  background: #4ade80;
  color: #1a1a1a;
}

.tier-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.tier-price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tier-price {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffe7a8;
}

.theme-light .tier-price {
  color: #d48806;
}

.theme-ocean .tier-price {
  color: #ffd54f;
}

.tier-original {
  font-size: 26rpx;
  text-decoration: line-through;
  color: rgba(255,255,255,0.50);
}
.theme-light .tier-original { color: #999999; }
.theme-ocean .tier-original { color: rgba(227,242,253,0.45); }

.tier-features {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tier-feature {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-icon {
  font-size: 24rpx;
  width: 36rpx;
  text-align: center;
}

.credits-icon {
  color: #667eea;
}
.theme-light .credits-icon { color: #07c160; }
.theme-ocean .credits-icon { color: #64b5f6; }

.check-icon {
  color: #4ade80;
}
.theme-light .check-icon { color: #07c160; }
.theme-ocean .check-icon { color: #4dd0e1; }

.cross-icon {
  color: rgba(255, 255, 255, 0.3);
}

.theme-light .cross-icon {
  color: #cccccc;
}

.theme-ocean .cross-icon {
  color: rgba(227, 242, 253, 0.30);
}

.feature-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.theme-light .feature-text {
  color: #333333;
}

.theme-ocean .feature-text {
  color: #e3f2fd;
}

.buy-btn {
  width: 100%;
  margin-top: 28rpx;
}

.btn-disabled {
  opacity: 0.5;
}
