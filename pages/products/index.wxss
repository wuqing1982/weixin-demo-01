.product-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.summary-pill {
  flex: 1;
  min-width: 140rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  /* dark: glass */
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
}

/* Light: white card */
.theme-light .summary-pill {
  background: #ffffff;
  border: 1px solid #e8e8e8;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* Ocean: blue ice */
.theme-ocean .summary-pill {
  background: rgba(20,60,120,0.25);
  border: 1px solid rgba(80,160,255,0.22);
}

.guest-tip {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 244, 219, 0.08);
  border: 1px solid rgba(255, 227, 173, 0.16);
}

.theme-light .guest-tip {
  background: #fffbe6;
  border: 1px solid #ffe58f;
  border-radius: 16rpx;
}

.theme-ocean .guest-tip {
  background: rgba(255,200,80,0.08);
  border: 1px solid rgba(255,200,80,0.20);
}

.summary-label,
.product-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.60);
}
.theme-light .summary-label,
.theme-light .product-subtitle { color: #888888; }
.theme-ocean .summary-label,
.theme-ocean .product-subtitle { color: rgba(180,220,255,0.60); }

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.summary-value.active {
  color: #4ade80;
}
.theme-light .summary-value.active { color: #07c160; }
.theme-ocean .summary-value.active { color: #00e5a0; }

.summary-value.inactive {
  color: rgba(255,255,255,0.40);
}
.theme-light .summary-value.inactive { color: #bbbbbb; }
.theme-ocean .summary-value.inactive { color: rgba(180,220,255,0.40); }

.summary-value.expires {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.40);
}
.theme-light .summary-value.expires { color: #bbbbbb; }
.theme-ocean .summary-value.expires { color: rgba(180,220,255,0.40); }

.guest-tip-title,
.guest-tip-desc {
  display: block;
}

.guest-tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe7a8;
}
.theme-light .guest-tip-title { color: #d48806; }
.theme-ocean .guest-tip-title { color: #ffd54f; }

.guest-tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.60);
}
.theme-light .guest-tip-desc { color: #888888; }
.theme-ocean .guest-tip-desc { color: rgba(180,220,255,0.60); }

.orders-btn {
  margin-top: 24rpx;
}

/* --- Tier Cards --- */

.tier-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tier-card {
  position: relative;
  padding: 32rpx;
  /* dark */
  border: 1px solid rgba(255,255,255,0.12);
}

/* Light: solid white */
.theme-light .tier-card {
  border-color: #e8e8e8;
}

/* Ocean: blue border */
.theme-ocean .tier-card {
  border-color: rgba(80,160,255,0.22);
}

.tier-recommended {
  border-color: rgba(250, 204, 21, 0.40);
  background: linear-gradient(135deg, rgba(250, 204, 21, 0.06), transparent 60%);
}

.theme-light .tier-recommended {
  background: linear-gradient(135deg, #fffbe6, transparent 60%);
  border-color: #fadb14;
}

.theme-ocean .tier-recommended {
  background: linear-gradient(135deg, rgba(255,200,80,0.08), transparent 60%);
  border-color: rgba(255,200,80,0.35);
}

.tier-current {
  border-color: rgba(74, 222, 128, 0.40);
}

.theme-light .tier-current {
  border-color: #07c160;
}

.theme-ocean .tier-current {
  border-color: rgba(0,200,160,0.40);
}

.tier-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: #facc15;
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 700;
}

.badge-current {
  background: #4ade80;
  color: #1a1a1a;
}

.theme-light .badge-current { background: #07c160; color: #ffffff; }
.theme-ocean .badge-current { background: #00e5a0; color: #041526; }

.tier-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.tier-price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tier-price {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffe7a8;
}

.theme-light .tier-price { color: #d48806; }
.theme-ocean .tier-price { color: #66d9ff; }

.tier-original {
  font-size: 26rpx;
  text-decoration: line-through;
  color: rgba(255,255,255,0.40);
}
.theme-light .tier-original { color: #bbbbbb; }
.theme-ocean .tier-original { color: rgba(180,220,255,0.40); }

.tier-features {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tier-feature {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-icon {
  font-size: 24rpx;
  width: 36rpx;
  text-align: center;
}

.credits-icon {
  color: #667eea;
}
.theme-light .credits-icon { color: #07c160; }
.theme-ocean .credits-icon { color: #00b8ff; }

.check-icon {
  color: #4ade80;
}
.theme-light .check-icon { color: #07c160; }
.theme-ocean .check-icon { color: #00e5a0; }

.cross-icon {
  color: rgba(255, 255, 255, 0.25);
}
.theme-light .cross-icon { color: #d9d9d9; }
.theme-ocean .cross-icon { color: rgba(180,220,255,0.25); }

.feature-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.80);
}
.theme-light .feature-text { color: #333333; }
.theme-ocean .feature-text { color: #e8f4ff; }

.buy-btn {
  width: 100%;
  margin-top: 28rpx;
}

.btn-disabled {
  opacity: 0.5;
}
