.product-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.summary-pill {
  flex: 1;
  min-width: 140rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  /* dark: glass */
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
}

/* Light: white card */
.summary-pill.theme-light {
  background: #ffffff !important;
  border: 1px solid #e8e8e8 !important;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06) !important;
}

/* Ocean: blue ice */
.summary-pill.theme-ocean {
  background: rgba(20,60,120,0.25) !important;
  border: 1px solid rgba(80,160,255,0.22) !important;
}

/* Active subscription pill highlight */
.pill-active {
  border-color: rgba(74, 222, 128, 0.40) !important;
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.10), rgba(74, 222, 128, 0.04)) !important;
}
.pill-active.theme-light {
  border-color: #07c160 !important;
  background: rgba(7, 193, 96, 0.06) !important;
}
.pill-active.theme-ocean {
  border-color: rgba(0, 200, 160, 0.40) !important;
  background: rgba(0, 200, 160, 0.08) !important;
}

.guest-tip {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 244, 219, 0.08) !important;
  border: 1px solid rgba(255, 227, 173, 0.16) !important;
}

.guest-tip.theme-light {
  background: #fffbe6 !important;
  border: 1px solid #ffe58f !important;
  border-radius: 16rpx;
}

.guest-tip.theme-ocean {
  background: rgba(255,200,80,0.08) !important;
  border: 1px solid rgba(255,200,80,0.20) !important;
}

.summary-label,
.product-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.60) !important;
}
.summary-label.theme-light,
.product-subtitle.theme-light { color: #888888 !important; }
.summary-label.theme-ocean,
.product-subtitle.theme-ocean { color: rgba(180,220,255,0.60) !important; }

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.summary-value.active {
  color: #4ade80 !important;
}
.summary-value.active.theme-light { color: #07c160 !important; }
.summary-value.active.theme-ocean { color: #00e5a0 !important; }

.summary-value.inactive {
  color: rgba(255,255,255,0.40) !important;
}
.summary-value.inactive.theme-light { color: #bbbbbb !important; }
.summary-value.inactive.theme-ocean { color: rgba(180,220,255,0.40) !important; }

.summary-value.expires {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.40) !important;
}
.summary-value.expires.theme-light { color: #bbbbbb !important; }
.summary-value.expires.theme-ocean { color: rgba(180,220,255,0.40) !important; }

.guest-tip-title,
.guest-tip-desc {
  display: block;
}

.guest-tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe7a8 !important;
}
.guest-tip-title.theme-light { color: #d48806 !important; }
.guest-tip-title.theme-ocean { color: #ffd54f !important; }

.guest-tip-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.60) !important;
}
.guest-tip-desc.theme-light { color: #888888 !important; }
.guest-tip-desc.theme-ocean { color: rgba(180,220,255,0.60) !important; }

.orders-btn {
  margin-top: 24rpx;
}

/* --- Tier Cards --- */

.tier-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tier-card {
  position: relative;
  padding: 32rpx;
  /* dark */
  border: 1px solid rgba(255,255,255,0.12) !important;
}

/* Light: solid white */
.tier-card.theme-light {
  border-color: #e8e8e8 !important;
}

/* Ocean: blue border */
.tier-card.theme-ocean {
  border-color: rgba(80,160,255,0.22) !important;
}

.tier-recommended {
  border-color: rgba(250, 204, 21, 0.40) !important;
  background: linear-gradient(135deg, rgba(250, 204, 21, 0.06), transparent 60%) !important;
}

.tier-recommended.theme-light {
  background: linear-gradient(135deg, #fffbe6, transparent 60%) !important;
  border-color: #fadb14 !important;
}

.tier-recommended.theme-ocean {
  background: linear-gradient(135deg, rgba(255,200,80,0.08), transparent 60%) !important;
  border-color: rgba(255,200,80,0.35) !important;
}

.tier-current {
  border-color: rgba(74, 222, 128, 0.40) !important;
}

.tier-current.theme-light {
  border-color: #07c160 !important;
}

.tier-current.theme-ocean {
  border-color: rgba(0,200,160,0.40) !important;
}

.tier-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
  background: #facc15 !important;
  color: #1a1a1a !important;
  font-size: 22rpx;
  font-weight: 700;
}

.badge-current {
  background: #4ade80 !important;
  color: #1a1a1a !important;
}

.badge-current.theme-light { background: #07c160 !important; color: #ffffff !important; }
.badge-current.theme-ocean { background: #00e5a0 !important; color: #041526 !important; }

.tier-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.tier-price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tier-price {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffe7a8 !important;
}

.tier-price.theme-light { color: #d48806 !important; }
.tier-price.theme-ocean { color: #66d9ff !important; }

.tier-original {
  font-size: 26rpx;
  text-decoration: line-through;
  color: rgba(255,255,255,0.40) !important;
}
.tier-original.theme-light { color: #bbbbbb !important; }
.tier-original.theme-ocean { color: rgba(180,220,255,0.40) !important; }

.tier-features {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tier-feature {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-icon {
  font-size: 24rpx;
  width: 36rpx;
  text-align: center;
}

.credits-icon {
  color: #667eea !important;
}
.credits-icon.theme-light { color: #07c160 !important; }
.credits-icon.theme-ocean { color: #00b8ff !important; }

.check-icon {
  color: #4ade80 !important;
}
.check-icon.theme-light { color: #07c160 !important; }
.check-icon.theme-ocean { color: #00e5a0 !important; }

.cross-icon {
  color: rgba(255, 255, 255, 0.25) !important;
}
.cross-icon.theme-light { color: #d9d9d9 !important; }
.cross-icon.theme-ocean { color: rgba(180,220,255,0.25) !important; }

.feature-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.80) !important;
}
.feature-text.theme-light { color: #333333 !important; }
.feature-text.theme-ocean { color: #e8f4ff !important; }

.buy-btn {
  width: 100%;
  margin-top: 28rpx;
}

.btn-disabled {
  opacity: 0.35;
}

/* --- Upgrade Hint --- */
.upgrade-hint {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(250, 204, 21, 0.08) !important;
  border: 1px solid rgba(250, 204, 21, 0.18) !important;
}

.upgrade-hint.theme-light {
  background: rgba(250, 204, 21, 0.06) !important;
  border-color: rgba(250, 204, 21, 0.22) !important;
}

.upgrade-hint.theme-ocean {
  background: rgba(255, 200, 80, 0.08) !important;
  border-color: rgba(255, 200, 80, 0.18) !important;
}

.upgrade-hint-text {
  font-size: 22rpx;
  color: #facc15 !important;
}

.upgrade-hint-text.theme-light {
  color: #d48806 !important;
}

.upgrade-hint-text.theme-ocean {
  color: #ffd54f !important;
}

/* --- CDK Buttons Row --- */
.cdk-actions-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-cdk {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: rgba(102, 126, 234, 0.12) !important;
  color: #667eea !important;
  border: 1px solid rgba(102, 126, 234, 0.25) !important;
}

.btn-cdk.theme-light {
  background: rgba(102, 126, 234, 0.08) !important;
  color: #667eea !important;
  border: 1px solid rgba(102, 126, 234, 0.20) !important;
}

.btn-cdk.theme-ocean {
  background: rgba(0, 180, 255, 0.10) !important;
  color: #66d9ff !important;
  border: 1px solid rgba(0, 180, 255, 0.25) !important;
}

.btn-cdk-record {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: rgba(74, 222, 128, 0.10) !important;
  color: #4ade80 !important;
  border: 1px solid rgba(74, 222, 128, 0.22) !important;
}

.btn-cdk-record.theme-light {
  background: rgba(7, 193, 96, 0.08) !important;
  color: #07c160 !important;
  border: 1px solid rgba(7, 193, 96, 0.18) !important;
}

.btn-cdk-record.theme-ocean {
  background: rgba(0, 200, 160, 0.10) !important;
  color: #5cf5c8 !important;
  border: 1px solid rgba(0, 200, 160, 0.22) !important;
}

/* --- CDK Modal --- */
.cdk-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.cdk-modal {
  width: 85%;
  max-width: 680rpx;
  padding: 48rpx;
  border-radius: 24rpx;
  background: #1a1a2e !important;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.cdk-modal.theme-light {
  background: #ffffff !important;
  border: 1px solid #e8e8e8;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.cdk-modal.theme-ocean {
  background: #0a1929 !important;
  border: 1px solid rgba(80, 160, 255, 0.22);
}

.cdk-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 30rpx;
  color: #ffffff !important;
}

.cdk-modal-title.theme-light { color: #1a1a1a !important; }
.cdk-modal-title.theme-ocean { color: #e8f4ff !important; }

.cdk-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.15) !important;
  color: #ffffff !important;
}

.cdk-input-focused {
  border-color: #667eea !important;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.25) !important;
}

.cdk-input.theme-light {
  background: #f5f5f5 !important;
  border: 2rpx solid #d9d9d9 !important;
  color: #1a1a1a !important;
}

.cdk-input-focused.theme-light {
  border-color: #667eea !important;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.15) !important;
}

.cdk-input.theme-ocean {
  background: rgba(20, 60, 120, 0.25) !important;
  border: 2rpx solid rgba(80, 160, 255, 0.22) !important;
  color: #e8f4ff !important;
}

.cdk-input-focused.theme-ocean {
  border-color: #66d9ff !important;
  box-shadow: 0 0 0 4rpx rgba(102, 217, 255, 0.25) !important;
}

.cdk-placeholder {
  color: rgba(255, 255, 255, 0.35) !important;
}

.cdk-placeholder.theme-light { color: #bbbbbb !important; }
.cdk-placeholder.theme-ocean { color: rgba(180, 220, 255, 0.40) !important; }

.cdk-modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.cdk-cancel-btn,
.cdk-confirm-btn {
  flex: 1;
  margin: 0;
}
