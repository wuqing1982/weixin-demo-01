.product-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.summary-pill {
  flex: 1;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.14);
}

.summary-label,
.product-subtitle,
.sku-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.orders-btn {
  margin-top: 24rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  padding: 28rpx;
}

.product-head,
.sku-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.product-name,
.sku-name {
  font-size: 32rpx;
  font-weight: 700;
}

.product-type,
.sku-price {
  font-size: 24rpx;
  color: #ffe7a8;
}

.product-subtitle {
  margin-top: 12rpx;
}

.sku-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.sku-desc {
  margin-top: 8rpx;
}

.benefit-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.benefit-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 235, 186, 0.12);
  color: #ffe6a3;
  font-size: 22rpx;
}

.buy-btn {
  width: 100%;
  margin-top: 20rpx;
}
