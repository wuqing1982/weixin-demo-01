.record-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
  font-size: 24rpx;
}

.summary-chip.theme-light {
  background: #ffffff !important;
  border: 1px solid #e8e8e8 !important;
}

.summary-chip.theme-ocean {
  background: rgba(20,60,120,0.25) !important;
  border: 1px solid rgba(80,160,255,0.22) !important;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  padding: 28rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-code {
  font-size: 28rpx;
  font-weight: 700;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.record-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.record-badge-redeemed {
  background: rgba(74,222,128,0.16) !important;
  color: #6ee7a0 !important;
}

.record-badge-redeemed.theme-light {
  background: rgba(7,193,96,0.10) !important;
  color: #07c160 !important;
}

.record-badge-redeemed.theme-ocean {
  background: rgba(0,200,160,0.16) !important;
  color: #5cf5c8 !important;
}

.record-body {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.50) !important;
}

.record-label.theme-light { color: #999999 !important; }
.record-label.theme-ocean { color: rgba(180,220,255,0.50) !important; }

.record-value {
  font-size: 24rpx;
  color: rgba(255,255,255,0.80) !important;
}

.record-value.theme-light { color: #333333 !important; }
.record-value.theme-ocean { color: #e8f4ff !important; }
