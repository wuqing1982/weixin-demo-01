.record-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
  font-size: 24rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  padding: 28rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-code {
  font-size: 28rpx;
  font-weight: 700;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.record-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.record-badge-redeemed {
  background: rgba(74,222,128,0.16) !important;
  color: #6ee7a0 !important;
}

.record-body {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.50) !important;
}

.record-value {
  font-size: 24rpx;
  color: rgba(255,255,255,0.80) !important;
}

/* ================================================================
   Notion overrides — page-specific
   ================================================================ */

/* Summary chip */
.summary-chip.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
}

/* Record badge redeemed */
.record-badge-redeemed.theme-notion {
  background: rgba(26,174,57,0.10) !important;
  color: #1aae39 !important;
}

/* Record label */
.record-label.theme-notion { color: #a39e98 !important; }

/* Record value */
.record-value.theme-notion { color: rgba(0,0,0,0.95) !important; }
