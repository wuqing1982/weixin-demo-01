.scene-page {
  min-height: 100vh;
  background: #0b0b0c;
}

.scene-stage {
  min-height: 100vh;
  padding: 24rpx 20rpx 32rpx;
}

.scene-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 177.7778%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #111111;
  border: 1px solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.4);
}

.scene-content {
  position: absolute;
  inset: 0;
}

.scene-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.scene-hotspots {
  position: absolute;
  inset: 0;
}

.zone {
  position: absolute;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0);
  border: 2px solid rgba(255, 255, 255, 0);
}

.zone-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  transform: translate(-50%, -50%);
  border-radius: 999rpx;
  background: #ffffff;
  border: 4rpx solid rgba(102, 126, 234, 0.95);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.35);
}

.zone-active {
  border-color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.14);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.18), 0 0 32rpx rgba(255, 255, 255, 0.28);
}

.zone-active .zone-dot {
  width: 22rpx;
  height: 22rpx;
}

.overlay {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.24), rgba(0, 0, 0, 0.46));
  border: 1px solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(12px);
  color: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.35);
}

.overlay-visible {
  border-color: rgba(255, 255, 255, 0.2);
}

.overlay-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.overlay-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.overlay-close {
  margin: 0;
  padding: 0;
  width: 52rpx;
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.18);
  font-size: 28rpx;
}

.overlay-close::after {
  border: 0;
}

.word {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ipa {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.74);
}

.meaning {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffd93d;
}

.sentence {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.45;
}

.translation {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.45;
  color: #ffd93d;
}

