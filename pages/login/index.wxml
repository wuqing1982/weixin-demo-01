<view class="page-root theme-{{theme}}">
<view class="login-page">
  <view class="ambient ambient-top"></view>
  <view class="ambient ambient-bottom"></view>

  <view class="login-shell">
    <view class="brand-copy">
      <text class="brand-tag">ENGLISH SCENE CLUB</text>
      <text class="brand-title">微信登录后，直接开始会员学习与场景生成</text>
      <text class="brand-subtitle">面向家长和孩子的英语场景小程序。登录后可购买包年会员、查看订单、生成私人场景，并继续编辑热点。</text>
    </view>

    <view class="hero-card">
      <view class="hero-badge">微信小程序账号</view>
      <text class="hero-title">一键登录</text>
      <text class="hero-desc">使用当前微信身份登录。首次进入会自动创建平台用户，后续订单、会员权益和私人场景都会绑定到同一个账号。</text>

      <view wx:if="{{me}}" class="current-user-card">
        <view class="current-user-head">
          <image wx:if="{{me.avatarUrl}}" class="current-user-avatar" src="{{me.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="current-user-avatar current-user-avatar-fallback">{{avatarLetter}}</view>
          <view class="current-user-copy">
            <text class="current-user-label">当前登录用户</text>
            <text class="current-user-name">{{me.displayName || '微信用户'}}</text>
            <text class="current-user-meta">身份：{{me.isAdmin ? 'Admin' : '普通用户'}} · 会员：{{me.memberSummary.isActive ? '已开通' : '未开通'}} · 点数：{{me.creditSummary.sceneGenerateBalance || 0}}</text>
          </view>
        </view>
        <view class="profile-sync-panel">
          <view class="profile-sync-row">
            <button class="profile-avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
              <image wx:if="{{profileDraftAvatarPreview}}" class="profile-avatar-preview" src="{{profileDraftAvatarPreview}}" mode="aspectFill"></image>
              <view wx:else class="profile-avatar-preview profile-avatar-fallback">{{avatarLetter}}</view>
              <text class="profile-avatar-copy">点击选择头像</text>
            </button>
            <view class="profile-sync-fields">
              <text class="profile-sync-label">微信昵称</text>
              <input
                class="profile-nickname-input"
                type="nickname"
                maxlength="20"
                placeholder="输入昵称后保存"
                value="{{profileDraftName}}"
                bindinput="onProfileNicknameInput"
              />
              <text class="profile-editor-tip">先选头像、再填昵称，最后点保存即可同步到当前账号。</text>
            </view>
          </view>
        </view>
        <view class="current-user-actions">
          <button class="cta-outline compact-btn" bindtap="onSyncWechatProfile" loading="{{syncingProfile}}">保存头像昵称</button>
          <button class="cta-login compact-btn" bindtap="onOpenHome">进入会员中心</button>
        </view>
      </view>

      <view class="benefit-list">
        <view class="benefit-pill">真实微信登录</view>
        <view class="benefit-pill">包年会员购买</view>
        <view class="benefit-pill">订单与点数同步</view>
      </view>

      <view class="offer-card" wx:if="{{featuredProduct && featuredProduct.featuredSku}}">
        <text class="offer-label">推荐套餐</text>
        <text class="offer-name">{{featuredProduct.name}}</text>
        <text class="offer-price">¥{{featuredProduct.featuredSku.salePrice}}</text>
        <text class="offer-desc">{{featuredProduct.featuredSku.name}}{{featuredProduct.featuredSku.durationDays ? ' · ' + featuredProduct.featuredSku.durationDays + '天' : ''}}</text>
      </view>

      <view class="offer-empty" wx:elif="{{offerMessage}}">{{offerMessage}}</view>
      <view class="offer-empty" wx:elif="{{loadingOffers}}">正在加载会员套餐...</view>

      <button wx:if="{{!me}}" class="cta-login" bindtap="onWechatLogin" loading="{{loggingIn}}">
        微信一键登录
      </button>
      <button class="cta-outline" bindtap="onOpenProducts">先看看会员套餐</button>

      <text wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</text>
      <text wx:if="{{profileMessage}}" class="success-text">{{profileMessage}}</text>
      <text class="agreement-copy">继续即表示你将使用当前微信身份登录，并在支付后自动绑定会员订单与点数权益。</text>
    </view>
  </view>
</view>
</view>
