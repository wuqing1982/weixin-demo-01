.create-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card,
.upload-card {
  padding: 28rpx;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.flex-btn {
  flex: 1;
}

.preview-image,
.preview-placeholder {
  width: 100%;
  height: 420rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
}

.preview-image {
  display: block;
}

.preview-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1px dashed rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.54);
  font-size: 26rpx;
}

.form-block,
.form-row,
.task-panel {
  margin-top: 24rpx;
}

.field-label,
.task-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

.title-input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 28rpx;
}

.placeholder {
  color: rgba(255, 255, 255, 0.36);
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-btn {
  width: 100%;
  margin-top: 28rpx;
}

.task-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
}

.task-status {
  font-size: 32rpx;
  font-weight: 700;
}

.task-step,
.task-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.error-text {
  display: block;
  margin-top: 20rpx;
  color: #ffb4b4;
  font-size: 24rpx;
}

.result-row {
  margin-top: 24rpx;
}
