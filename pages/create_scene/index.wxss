.create-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card,
.upload-card {
  padding: 28rpx;
}

.tip-text {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.60) !important;
}

.tip-text.theme-light { color: #888888 !important; }
.tip-text.theme-ocean { color: rgba(180, 220, 255, 0.60) !important; }

.button-row {
  display: flex;
  gap: 16rpx;
}

.flex-btn {
  flex: 1;
}

.preview-image,
.preview-placeholder {
  width: 100%;
  height: 420rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
}

.preview-image {
  display: block;
}

/* Dark: glass */
.preview-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04) !important;
  border: 1px dashed rgba(255, 255, 255, 0.18) !important;
  color: rgba(255, 255, 255, 0.45) !important;
  font-size: 26rpx;
}

/* Light: light gray */
.preview-placeholder.theme-light {
  background: #fafafa !important;
  border-color: #d9d9d9 !important;
  color: #bbbbbb !important;
  border-radius: 16rpx;
}

/* Ocean: blue glass */
.preview-placeholder.theme-ocean {
  background: rgba(20, 60, 120, 0.15) !important;
  border-color: rgba(80, 160, 255, 0.22) !important;
  color: rgba(180, 220, 255, 0.45) !important;
}

.form-block,
.form-row,
.task-panel {
  margin-top: 24rpx;
}

.field-label,
.task-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.88) !important;
}

.field-label.theme-light,
.task-title.theme-light {
  color: #333333 !important;
}

.field-label.theme-ocean,
.task-title.theme-ocean {
  color: #e8f4ff !important;
}

.title-input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08) !important;
  color: #ffffff !important;
  font-size: 28rpx;
}

.title-input.theme-light {
  background: #ffffff !important;
  color: #333333 !important;
  border: 1px solid #d9d9d9 !important;
  border-radius: 12rpx;
}

.title-input.theme-ocean {
  background: rgba(20, 60, 120, 0.25) !important;
  color: #e3f2fd !important;
  border: 1px solid rgba(80, 160, 255, 0.22) !important;
}

.placeholder {
  color: rgba(255, 255, 255, 0.30) !important;
}

.placeholder.theme-light { color: #bbbbbb !important; }
.placeholder.theme-ocean { color: rgba(180, 220, 255, 0.30) !important; }

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-btn {
  width: 100%;
  margin-top: 28rpx;
}

.compress-panel,
.task-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compress-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04) !important;
}

.compress-panel.theme-light {
  background: #fafafa !important;
  border: 1px solid #f0f0f0 !important;
  border-radius: 16rpx;
}

.compress-panel.theme-ocean {
  background: rgba(20, 60, 120, 0.15) !important;
  border: 1px solid rgba(80, 160, 255, 0.15) !important;
}

.compress-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60) !important;
}

.compress-meta.theme-light { color: #888888 !important; }
.compress-meta.theme-ocean { color: rgba(180, 220, 255, 0.60) !important; }

.task-panel {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05) !important;
}

.task-panel.theme-light {
  background: #fafafa !important;
  border: 1px solid #f0f0f0 !important;
  border-radius: 16rpx;
}

.task-panel.theme-ocean {
  background: rgba(20, 60, 120, 0.18) !important;
  border: 1px solid rgba(80, 160, 255, 0.18) !important;
}

.task-status {
  font-size: 32rpx;
  font-weight: 700;
}

.task-step,
.task-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60) !important;
}

.task-step.theme-light,
.task-meta.theme-light { color: #888888 !important; }
.task-step.theme-ocean,
.task-meta.theme-ocean { color: rgba(180, 220, 255, 0.60) !important; }

.error-text {
  display: block;
  margin-top: 20rpx;
  color: #fca5a5 !important;
  font-size: 24rpx;
}

.error-text.theme-light { color: #fa5151 !important; }
.error-text.theme-ocean { color: #ff8a8a !important; }

/* ================================================================
   Notion overrides — page-specific
   ================================================================ */

/* Tip text */
.tip-text.theme-notion { color: #a39e98 !important; }

/* Preview placeholder */
.preview-placeholder.theme-notion {
  background: #f6f5f4 !important;
  border-color: #dddddd !important;
  color: #a39e98 !important;
  border-radius: 16rpx !important;
}

/* Field label / task title */
.field-label.theme-notion,
.task-title.theme-notion {
  color: rgba(0,0,0,0.95) !important;
}

/* Title input */
.title-input.theme-notion {
  background: #ffffff !important;
  color: rgba(0,0,0,0.95) !important;
  border: 1px solid #dddddd !important;
  border-radius: 8rpx !important;
}

/* Placeholder */
.placeholder.theme-notion { color: #a39e98 !important; }

/* Compress panel */
.compress-panel.theme-notion {
  background: #f6f5f4 !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  border-radius: 16rpx !important;
}

.compress-meta.theme-notion { color: #615d59 !important; }

/* Task panel */
.task-panel.theme-notion {
  background: #f6f5f4 !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  border-radius: 16rpx !important;
}

.task-step.theme-notion,
.task-meta.theme-notion { color: #615d59 !important; }

/* Error text */
.error-text.theme-notion { color: #dd5b00 !important; }

.result-row {
  margin-top: 24rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
