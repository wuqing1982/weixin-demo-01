.create-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card,
.upload-card {
  padding: 28rpx;
}

.tip-text {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.60);
}

.theme-light .tip-text { color: #888888; }
.theme-ocean .tip-text { color: rgba(180, 220, 255, 0.60); }

.button-row {
  display: flex;
  gap: 16rpx;
}

.flex-btn {
  flex: 1;
}

.preview-image,
.preview-placeholder {
  width: 100%;
  height: 420rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
}

.preview-image {
  display: block;
}

/* Dark: glass */
.preview-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1px dashed rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.45);
  font-size: 26rpx;
}

/* Light: light gray */
.theme-light .preview-placeholder {
  background: #fafafa;
  border-color: #d9d9d9;
  color: #bbbbbb;
  border-radius: 16rpx;
}

/* Ocean: blue glass */
.theme-ocean .preview-placeholder {
  background: rgba(20, 60, 120, 0.15);
  border-color: rgba(80, 160, 255, 0.22);
  color: rgba(180, 220, 255, 0.45);
}

.form-block,
.form-row,
.task-panel {
  margin-top: 24rpx;
}

.field-label,
.task-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.88);
}

.theme-light .field-label,
.theme-light .task-title {
  color: #333333;
}

.theme-ocean .field-label,
.theme-ocean .task-title {
  color: #e8f4ff;
}

.title-input {
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 28rpx;
}

.theme-light .title-input {
  background: #ffffff;
  color: #333333;
  border: 1px solid #d9d9d9;
  border-radius: 12rpx;
}

.theme-ocean .title-input {
  background: rgba(20, 60, 120, 0.25);
  color: #e3f2fd;
  border: 1px solid rgba(80, 160, 255, 0.22);
}

.placeholder {
  color: rgba(255, 255, 255, 0.30);
}

.theme-light .placeholder { color: #bbbbbb; }
.theme-ocean .placeholder { color: rgba(180, 220, 255, 0.30); }

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-btn {
  width: 100%;
  margin-top: 28rpx;
}

.compress-panel,
.task-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compress-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}

.theme-light .compress-panel {
  background: #fafafa;
  border: 1px solid #f0f0f0;
  border-radius: 16rpx;
}

.theme-ocean .compress-panel {
  background: rgba(20, 60, 120, 0.15);
  border: 1px solid rgba(80, 160, 255, 0.15);
}

.compress-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60);
}

.theme-light .compress-meta { color: #888888; }
.theme-ocean .compress-meta { color: rgba(180, 220, 255, 0.60); }

.task-panel {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
}

.theme-light .task-panel {
  background: #fafafa;
  border: 1px solid #f0f0f0;
  border-radius: 16rpx;
}

.theme-ocean .task-panel {
  background: rgba(20, 60, 120, 0.18);
  border: 1px solid rgba(80, 160, 255, 0.18);
}

.task-status {
  font-size: 32rpx;
  font-weight: 700;
}

.task-step,
.task-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60);
}

.theme-light .task-step,
.theme-light .task-meta { color: #888888; }
.theme-ocean .task-step,
.theme-ocean .task-meta { color: rgba(180, 220, 255, 0.60); }

.error-text {
  display: block;
  margin-top: 20rpx;
  color: #fca5a5;
  font-size: 24rpx;
}

.theme-light .error-text { color: #fa5151; }
.theme-ocean .error-text { color: #ff8a8a; }

.result-row {
  margin-top: 24rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
