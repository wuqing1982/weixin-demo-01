.create-btn {
  margin-top: 24rpx;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff !important;
}
.section-heading.theme-notion { color: rgba(0,0,0,0.95) !important; }

.filter-scroll {
  width: 100%;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
  padding-bottom: 4rpx;
}

/* ---- Filter chips — strongly themed ---- */

.filter-chip {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
  /* dark */
  background: rgba(255,255,255,0.07) !important;
  color: rgba(255,255,255,0.60) !important;
}

/* Light: white chips with border */

/* Ocean: blue glass chips */

/* Notion: clean white chips */
.filter-chip.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  color: #615d59 !important;
  border-radius: 999rpx;
}

/* Active states */
.filter-chip-active {
  background: rgba(126, 240, 191, 0.16) !important;
  border-color: transparent !important;
  color: #d8fff0 !important;
}

.filter-chip-active.theme-notion {
  background: #0075de !important;
  border-color: transparent !important;
  color: #ffffff !important;
}

.scene-card {
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.scene-meta {
  padding: 24rpx;
}

.scene-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.scene-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.65) !important;
}
.scene-desc.theme-notion { color: #615d59 !important; }

/* ---- Dual-column grid layout ---- */

.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.scene-cover-grid {
  height: 200rpx;
}

.scene-meta-grid {
  padding: 16rpx;
}

.scene-title-grid {
  font-size: 26rpx;
}

/* ---- Section header with toggle ---- */

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.view-toggle {
  padding: 12rpx 16rpx;
}

.toggle-icon {
  font-size: 36rpx;
  opacity: 0.6;
}

/* ---- End-of-list tip ---- */

.list-end-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.40) !important;
}
.list-end-tip.theme-notion { color: #a39e98 !important; }

/* ---- Pagination bar ---- */

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0;
}

.page-num {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.07) !important;
  color: rgba(255,255,255,0.60) !important;
}

.page-num.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  color: #615d59 !important;
}

.page-num-active {
  background: rgba(126, 240, 191, 0.16) !important;
  color: #d8fff0 !important;
}

.page-num-active.theme-notion {
  background: #0075de !important;
  color: #ffffff !important;
}

.page-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  color: rgba(255,255,255,0.50) !important;
}

.page-btn.theme-notion { color: #a39e98 !important; }

.page-btn-disabled {
  opacity: 0.3;
}
