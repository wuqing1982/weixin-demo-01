.create-btn {
  margin-top: 24rpx;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}
.theme-light .section-heading { color: #1a1a1a; }
.theme-ocean .section-heading { color: #e8f4ff; }

.filter-scroll {
  width: 100%;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
  padding-bottom: 4rpx;
}

/* ---- Filter chips — strongly themed ---- */

.filter-chip {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
  /* dark */
  background: rgba(255,255,255,0.07);
  color: rgba(255,255,255,0.60);
}

/* Light: white chips with border */
.theme-light .filter-chip {
  background: #ffffff;
  border: 1px solid #e0e0e0;
  color: #666666;
  border-radius: 999rpx;
}

/* Ocean: blue glass chips */
.theme-ocean .filter-chip {
  background: rgba(20,60,120,0.25);
  border: 1px solid rgba(80,160,255,0.18);
  color: rgba(180,220,255,0.65);
}

/* Active states */
.filter-chip-active {
  background: rgba(126, 240, 191, 0.16);
  border-color: transparent;
  color: #d8fff0;
}

.theme-light .filter-chip-active {
  background: #07c160;
  border-color: transparent;
  color: #ffffff;
}

.theme-ocean .filter-chip-active {
  background: rgba(0,184,255,0.20);
  border-color: transparent;
  color: #66d9ff;
}

.scene-card {
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.scene-meta {
  padding: 24rpx;
}

.scene-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.scene-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
}
.theme-light .scene-desc { color: #888888; }
.theme-ocean .scene-desc { color: rgba(180,220,255,0.65); }
