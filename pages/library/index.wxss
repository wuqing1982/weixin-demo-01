.create-btn {
  margin-top: 24rpx;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}
.theme-light .section-heading { color: #191919; }
.theme-ocean .section-heading { color: #e3f2fd; }

.filter-scroll {
  width: 100%;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
  padding-bottom: 4rpx;
}

.filter-chip {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(255,255,255,0.08);
  font-size: 24rpx;
  line-height: 1;
}
/* dark */
.filter-chip { color: rgba(255,255,255,0.72); }
.theme-light .filter-chip {
  background: #f0f0f2;
  border-color: #e0e0e0;
  color: #666666;
}
.theme-ocean .filter-chip {
  background: rgba(100,180,255,0.08);
  border-color: rgba(100,180,255,0.08);
  color: rgba(227,242,253,0.70);
}

.filter-chip-active {
  background: rgba(126, 240, 191, 0.16);
  border-color: rgba(126, 240, 191, 0.4);
  color: #d8fff0;
}

.theme-light .filter-chip-active {
  background: rgba(7, 193, 96, 0.12);
  border-color: rgba(7, 193, 96, 0.4);
  color: #07c160;
}

.theme-ocean .filter-chip-active {
  background: rgba(77, 208, 225, 0.16);
  border-color: rgba(77, 208, 225, 0.4);
  color: #80deea;
}

.scene-card {
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.scene-meta {
  padding: 24rpx;
}

.scene-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.scene-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}
/* dark */
.scene-desc { color: rgba(255,255,255,0.72); }
.theme-light .scene-desc { color: #666666; }
.theme-ocean .scene-desc { color: rgba(227,242,253,0.70); }
