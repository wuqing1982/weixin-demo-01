.create-btn {
  margin-top: 24rpx;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff !important;
}
.section-heading.theme-light { color: #1a1a1a !important; }
.section-heading.theme-ocean { color: #e8f4ff !important; }

.filter-scroll {
  width: 100%;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
  padding-bottom: 4rpx;
}

/* ---- Filter chips — strongly themed ---- */

.filter-chip {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
  /* dark */
  background: rgba(255,255,255,0.07) !important;
  color: rgba(255,255,255,0.60) !important;
}

/* Light: white chips with border */
.filter-chip.theme-light {
  background: #ffffff !important;
  border: 1px solid #e0e0e0 !important;
  color: #666666 !important;
  border-radius: 999rpx;
}

/* Ocean: blue glass chips */
.filter-chip.theme-ocean {
  background: rgba(20,60,120,0.25) !important;
  border: 1px solid rgba(80,160,255,0.18) !important;
  color: rgba(180,220,255,0.65) !important;
}

/* Active states */
.filter-chip-active {
  background: rgba(126, 240, 191, 0.16) !important;
  border-color: transparent !important;
  color: #d8fff0 !important;
}

.filter-chip-active.theme-light {
  background: #07c160 !important;
  border-color: transparent !important;
  color: #ffffff !important;
}

.filter-chip-active.theme-ocean {
  background: rgba(0,184,255,0.20) !important;
  border-color: transparent !important;
  color: #66d9ff !important;
}

.scene-card {
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.scene-meta {
  padding: 24rpx;
}

.scene-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.scene-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.65) !important;
}
.scene-desc.theme-light { color: #888888 !important; }
.scene-desc.theme-ocean { color: rgba(180,220,255,0.65) !important; }
