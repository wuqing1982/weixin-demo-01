.page-root {
  min-height: 100vh;
}

.scene-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(60, 72, 110, 0.34), transparent 36%),
    linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-end) 100%);
  color: var(--color-text);
}

.scene-stage {
  min-height: 100vh;
  padding: 28rpx 20rpx 36rpx;
}

.scene-page .state-card {
  margin-top: 28rpx;
}

.scene-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 14rpx;
  background: var(--color-overlay);
  border: 1px solid var(--color-surface-border);
  border-radius: 20rpx;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.toolbar-slot {
  min-width: 0;
  display: flex;
  align-items: center;
}

.toolbar-slot-left {
  justify-content: flex-start;
  flex: 0 0 auto;
}

.toolbar-slot-center {
  justify-content: center;
  flex: 1 1 auto;
  padding: 0 4rpx;
}

.toolbar-slot-right {
  justify-content: flex-end;
  flex: 0 0 auto;
}

.toolbar-rail {
  display: flex;
  align-items: center;
  border-radius: 18rpx;
  border: 1px solid var(--color-surface-border);
  background: var(--color-surface);
  box-shadow: inset 0 1rpx 0 var(--color-surface);
}

.toolbar-rail-mode {
  padding: 8rpx 16rpx;
}

.toolbar-rail-rate {
  width: 100%;
  max-width: 280rpx;
  min-width: 0;
  padding: 8rpx 12rpx 6rpx;
}

.toolbar-rail-actions {
  gap: 8rpx;
  padding: 4rpx;
}

.toolbar-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toolbar-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 1px solid var(--color-surface-border);
  font-size: 24rpx;
  transition: all 0.2s ease;
  flex: 0 0 auto;
}

.toolbar-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  box-shadow: 0 0 20rpx var(--color-shadow);
}

.rate-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.rate-control-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  gap: 6rpx;
}

.rate-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: var(--color-surface);
  border: 1px solid var(--color-surface-border);
  font-size: 20rpx;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.rate-icon.active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-end));
  border-color: var(--color-primary);
  box-shadow: 0 0 16rpx var(--color-shadow);
}

.rate-slider {
  flex: 1;
  margin: 0;
  min-width: 72rpx;
  height: 36rpx;
}

.rate-display {
  font-size: 20rpx;
  color: var(--color-text);
  font-weight: 600;
  text-align: center;
  min-width: 48rpx;
  letter-spacing: 0.5rpx;
}

.repeat-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  box-shadow: 0 0 20rpx var(--color-shadow);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 20rpx var(--color-shadow);
  }
  50% {
    box-shadow: 0 0 40rpx var(--color-primary);
  }
}

.camera-btn,
.export-btn {
  font-size: 28rpx;
}

.editor-mode-group {
  flex-shrink: 0;
  gap: 18rpx;
}

.mode-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-surface-border);
  box-shadow: 0 0 0 4rpx var(--color-surface);
}

.mode-dot-edit {
  background: var(--color-success);
}

.mode-dot-browse {
  background: var(--color-danger);
}

.mode-dot-active {
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.12), 0 0 18rpx rgba(255, 255, 255, 0.14);
  transform: scale(1.05);
}

.mode-dot-inactive {
  opacity: 0.42;
}

.scene-frame-wrapper {
  width: 100%;
  transition: all 0.3s ease;
}

.scene-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 177.7778%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #111111;
  border: 1px solid var(--color-surface-border);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.4);
}

.scene-content {
  position: absolute;
  inset: 0;
}

.scene-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.scene-hotspots {
  position: absolute;
  inset: 0;
}

.zone {
  position: absolute;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0);
  border: 2px solid rgba(255, 255, 255, 0);
}

.zone-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  transform: translate(-50%, -50%);
  border-radius: 999rpx;
  background: #ffffff;
  border: 4rpx solid var(--color-primary);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.35);
}

.zone-active {
  border-color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.14);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.18), 0 0 32rpx rgba(255, 255, 255, 0.28);
}

.zone-active .zone-dot {
  width: 22rpx;
  height: 22rpx;
}

.zone-editor {
  border-color: var(--color-warning);
  background: rgba(255, 205, 96, 0.08);
}

.zone-editor .zone-dot {
  border-color: var(--color-warning);
}

.zone-editor-active {
  border-color: var(--color-warning);
  background: rgba(255, 194, 71, 0.24);
  box-shadow: 0 0 0 4rpx rgba(255, 220, 128, 0.22), 0 0 32rpx rgba(255, 188, 66, 0.35);
}

.zone-label {
  position: absolute;
  left: 12rpx;
  top: -52rpx;
  max-width: 220rpx;
  padding: 8rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #fff9e6;
  background: rgba(20, 20, 20, 0.72);
  border: 1px solid var(--color-warning);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.zone-handle {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #fff8e1;
  border: 3rpx solid var(--color-warning);
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.25);
}

.zone-handle-nw {
  left: -12rpx;
  top: -12rpx;
}

.zone-handle-n {
  left: 50%;
  top: -12rpx;
  transform: translateX(-50%);
}

.zone-handle-ne {
  right: -12rpx;
  top: -12rpx;
}

.zone-handle-e {
  right: -12rpx;
  top: 50%;
  transform: translateY(-50%);
}

.zone-handle-se {
  right: -12rpx;
  bottom: -12rpx;
}

.zone-handle-s {
  left: 50%;
  bottom: -12rpx;
  transform: translateX(-50%);
}

.zone-handle-sw {
  left: -12rpx;
  bottom: -12rpx;
}

.zone-handle-w {
  left: -12rpx;
  top: 50%;
  transform: translateY(-50%);
}

.floating-save-anchor {
  position: fixed;
  z-index: 10000;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.floating-save-anchor-dragging {
  transform: scale(1.02);
}

.floating-save-handle {
  width: 46rpx;
  height: 82rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-surface-border);
  box-shadow: 0 12rpx 28rpx var(--color-shadow);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.floating-save-handle-active {
  background: var(--color-surface);
  border-color: var(--color-success);
  box-shadow: 0 0 0 6rpx rgba(40, 186, 96, 0.14), 0 16rpx 32rpx var(--color-shadow);
}

.floating-save-grip {
  width: 6rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(57, 77, 63, 0.82);
}

.floating-save-grip-top {
  box-shadow: 10rpx 0 0 rgba(57, 77, 63, 0.82);
}

.floating-save-grip-bottom {
  box-shadow: 10rpx 0 0 rgba(57, 77, 63, 0.82);
}

.floating-save-btn {
  min-width: 112rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-success);
  border: 2rpx solid var(--color-success-end);
  box-shadow: 0 16rpx 36rpx var(--color-shadow);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

.floating-save-btn-dirty {
  background: linear-gradient(135deg, var(--color-success), var(--color-success-end));
}

.floating-save-btn-saving {
  opacity: 0.86;
}

.floating-save-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #f4fff7;
  letter-spacing: 1rpx;
}

.overlay {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--color-overlay);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1px solid var(--color-surface-border);
  color: var(--color-text);
  box-shadow: 0 16rpx 60rpx var(--color-shadow);
}

.scene-frame-has-verbs .overlay {
  bottom: 96rpx;
}

.overlay-visible {
  border-color: var(--color-surface-border);
}

.overlay-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.overlay-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.overlay-close {
  margin: 0;
  padding: 0;
  width: 52rpx;
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-surface-border);
  font-size: 28rpx;
}

.overlay-close::after {
  border: 0;
}

.word {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ipa {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.meaning {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-warning);
}

.sentence {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.45;
}

.translation {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.45;
  color: var(--color-warning);
}

.placeholder {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--color-text-placeholder);
}

.verb-strip {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.verb-chip {
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  background: linear-gradient(180deg, var(--color-primary), var(--color-primary-end));
  border: 1px solid var(--color-surface-border);
  box-shadow: 0 10rpx 22rpx var(--color-shadow);
}

.verb-chip-active {
  box-shadow: 0 0 0 4rpx var(--color-surface-border), 0 12rpx 28rpx var(--color-shadow);
}

@media screen and (min-width: 768px) {
  .scene-frame-wrapper {
    max-width: 75%;
    margin: 0 auto;
  }
}

@media screen and (min-width: 1280px) {
  .scene-frame-wrapper {
    max-width: 60%;
  }
}

@media screen and (max-width: 375px) {
  .scene-toolbar {
    padding: 10rpx 12rpx;
    gap: 8rpx;
  }

  .toolbar-slot-center {
    padding: 0 2rpx;
  }

  .toolbar-rail-rate {
    max-width: 220rpx;
    padding: 6rpx 8rpx 4rpx;
  }

  .toolbar-btn {
    width: 44rpx;
    height: 44rpx;
    font-size: 22rpx;
  }

  .rate-icon {
    width: 32rpx;
    height: 32rpx;
    font-size: 18rpx;
  }

  .rate-slider {
    min-width: 56rpx;
  }

  .rate-display {
    min-width: 40rpx;
    font-size: 18rpx;
  }

  .mode-dot {
    width: 24rpx;
    height: 24rpx;
  }

  .floating-save-btn {
    min-width: 104rpx;
    height: 68rpx;
  }

  .floating-save-handle {
    width: 42rpx;
    height: 76rpx;
  }
}
