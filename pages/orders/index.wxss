.order-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  /* dark */
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
  font-size: 24rpx;
}

/* Light: white pill */
.summary-chip.theme-light {
  background: #ffffff !important;
  border: 1px solid #e8e8e8 !important;
  border-radius: 999rpx;
}

/* Ocean: blue glass */
.summary-chip.theme-ocean {
  background: rgba(20,60,120,0.25) !important;
  border: 1px solid rgba(80,160,255,0.22) !important;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
}

.order-head,
.order-item-row,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-no,
.order-item-name,
.order-total {
  font-size: 28rpx;
  font-weight: 700;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-transform: uppercase;
}

/* Dark status */
.order-status-pending {
  background: rgba(251,191,36,0.16) !important;
  color: #fcd34d !important;
}
.order-status-paid {
  background: rgba(74,222,128,0.16) !important;
  color: #6ee7a0 !important;
}

/* Light status — sharper, more vivid */
.order-status-pending.theme-light {
  background: rgba(237, 106, 12, 0.10) !important;
  color: #d46b08 !important;
}
.order-status-paid.theme-light {
  background: rgba(7, 193, 96, 0.10) !important;
  color: #07c160 !important;
}

/* Ocean status — cyan/teal */
.order-status-pending.theme-ocean {
  background: rgba(255, 183, 77, 0.16) !important;
  color: #ffb74d !important;
}
.order-status-paid.theme-ocean {
  background: rgba(0,200,160,0.16) !important;
  color: #5cf5c8 !important;
}

.order-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
}

.order-item.theme-light {
  border-top-color: #f0f0f0 !important;
}

.order-item.theme-ocean {
  border-top-color: rgba(80, 160, 255, 0.12) !important;
}

.order-item-desc,
.order-item-price {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60) !important;
}

.order-item-desc.theme-light,
.order-item-price.theme-light {
  color: #888888 !important;
}

.order-item-desc.theme-ocean,
.order-item-price.theme-ocean {
  color: rgba(180, 220, 255, 0.60) !important;
}

.order-foot {
  margin-top: 22rpx;
}

.pay-btn {
  min-width: 220rpx;
}

.paid-tip {
  color: #6ee7a0 !important;
}

.paid-tip.theme-light {
  color: #07c160 !important;
}

.paid-tip.theme-ocean {
  color: #5cf5c8 !important;
}
