.order-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
}

.order-head,
.order-item-row,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-no,
.order-item-name,
.order-total {
  font-size: 28rpx;
  font-weight: 700;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-transform: uppercase;
}

.order-status-pending {
  background: rgba(255, 197, 84, 0.14);
  color: #ffd479;
}

.order-status-paid {
  background: rgba(54, 204, 113, 0.14);
  color: #98f0a5;
}

.order-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.order-item-desc,
.paid-tip,
.order-item-price {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.order-foot {
  margin-top: 22rpx;
}

.pay-btn {
  min-width: 220rpx;
}

.paid-tip {
  color: #9af3a6;
}
