.order-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  /* dark */
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
  font-size: 24rpx;
}
.theme-light .summary-chip {
  background: #f0f0f2;
  border-color: #e0e0e0;
}
.theme-ocean .summary-chip {
  background: rgba(100,180,255,0.08);
  border-color: rgba(100,180,255,0.18);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
}

.order-head,
.order-item-row,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-no,
.order-item-name,
.order-total {
  font-size: 28rpx;
  font-weight: 700;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-transform: uppercase;
}

.order-status-pending {
  background: rgba(255, 197, 84, 0.14);
  color: #ffd479;
}

.order-status-paid {
  background: rgba(54, 204, 113, 0.14);
  color: #98f0a5;
}

.order-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.theme-light .order-status-pending {
  background: rgba(237, 106, 12, 0.10);
  color: #d46b08;
}

.theme-light .order-status-paid {
  background: rgba(7, 193, 96, 0.10);
  color: #07c160;
}

.theme-light .order-item {
  border-top-color: #e8e8e8;
}

.theme-ocean .order-status-pending {
  background: rgba(255, 183, 77, 0.14);
  color: #ffb74d;
}

.theme-ocean .order-status-paid {
  background: rgba(77, 208, 225, 0.14);
  color: #80deea;
}

.theme-ocean .order-item {
  border-top-color: rgba(100, 180, 255, 0.10);
}

.order-item-desc,
.order-item-price {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.theme-light .order-item-desc,
.theme-light .order-item-price {
  color: #666666;
}

.theme-ocean .order-item-desc,
.theme-ocean .order-item-price {
  color: rgba(227, 242, 253, 0.70);
}

.order-foot {
  margin-top: 22rpx;
}

.pay-btn {
  min-width: 220rpx;
}

.paid-tip {
  color: #9af3a6;
}

.theme-light .paid-tip {
  color: #07c160;
}

.theme-ocean .paid-tip {
  color: #4dd0e1;
}
