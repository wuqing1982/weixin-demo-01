.order-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  /* dark */
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
  font-size: 24rpx;
}

/* Light: white pill */

/* Ocean: blue glass */

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
}

.order-head,
.order-item-row,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-no,
.order-item-name,
.order-total {
  font-size: 28rpx;
  font-weight: 700;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-transform: uppercase;
}

/* Dark status */
.order-status-pending {
  background: rgba(251,191,36,0.16) !important;
  color: #fcd34d !important;
}
.order-status-paid {
  background: rgba(74,222,128,0.16) !important;
  color: #6ee7a0 !important;
}

/* Light status — sharper, more vivid */

/* Ocean status — cyan/teal */

.order-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
}

.order-item-desc,
.order-item-price {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60) !important;
}

.order-foot {
  margin-top: 22rpx;
}

.pay-btn {
  min-width: 220rpx;
}

.paid-tip {
  color: #6ee7a0 !important;
}

/* ================================================================
   Notion overrides — page-specific
   ================================================================ */

/* Summary chip */
.summary-chip.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
}

/* Order status badges */
.order-status-pending.theme-notion {
  background: rgba(221,91,0,0.10) !important;
  color: #dd5b00 !important;
}
.order-status-paid.theme-notion {
  background: rgba(26,174,57,0.10) !important;
  color: #1aae39 !important;
}

/* Order item divider */
.order-item.theme-notion {
  border-top-color: rgba(0,0,0,0.1) !important;
}

/* Order item desc / price */
.order-item-desc.theme-notion,
.order-item-price.theme-notion {
  color: #615d59 !important;
}

/* Paid tip */
.paid-tip.theme-notion {
  color: #1aae39 !important;
}
