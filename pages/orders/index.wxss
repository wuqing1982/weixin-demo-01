.order-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 1px solid var(--color-surface-border);
  font-size: 24rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
}

.order-head,
.order-item-row,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-no,
.order-item-name,
.order-total {
  font-size: 28rpx;
  font-weight: 700;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-transform: uppercase;
}

.order-status-pending {
  background: var(--color-surface);
  color: var(--color-warning);
}

.order-status-paid {
  background: var(--color-surface);
  color: var(--color-success);
}

.order-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid var(--color-surface);
}

.order-item-desc,
.paid-tip,
.order-item-price {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.order-foot {
  margin-top: 22rpx;
}

.pay-btn {
  min-width: 220rpx;
}

.paid-tip {
  color: var(--color-success);
}
