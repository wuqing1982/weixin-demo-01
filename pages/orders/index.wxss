.order-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  padding: 34rpx;
}

.summary-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.summary-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  /* dark */
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  font-size: 24rpx;
}

/* Light: white pill */
.theme-light .summary-chip {
  background: #ffffff;
  border: 1px solid #e8e8e8;
  border-radius: 999rpx;
}

/* Ocean: blue glass */
.theme-ocean .summary-chip {
  background: rgba(20,60,120,0.25);
  border: 1px solid rgba(80,160,255,0.22);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
}

.order-head,
.order-item-row,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-no,
.order-item-name,
.order-total {
  font-size: 28rpx;
  font-weight: 700;
}

.order-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  text-transform: uppercase;
}

/* Dark status */
.order-status-pending {
  background: rgba(251,191,36,0.16);
  color: #fcd34d;
}
.order-status-paid {
  background: rgba(74,222,128,0.16);
  color: #6ee7a0;
}

/* Light status — sharper, more vivid */
.theme-light .order-status-pending {
  background: rgba(237, 106, 12, 0.10);
  color: #d46b08;
}
.theme-light .order-status-paid {
  background: rgba(7, 193, 96, 0.10);
  color: #07c160;
}

/* Ocean status — cyan/teal */
.theme-ocean .order-status-pending {
  background: rgba(255, 183, 77, 0.16);
  color: #ffb74d;
}
.theme-ocean .order-status-paid {
  background: rgba(0,200,160,0.16);
  color: #5cf5c8;
}

.order-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.theme-light .order-item {
  border-top-color: #f0f0f0;
}

.theme-ocean .order-item {
  border-top-color: rgba(80, 160, 255, 0.12);
}

.order-item-desc,
.order-item-price {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60);
}

.theme-light .order-item-desc,
.theme-light .order-item-price {
  color: #888888;
}

.theme-ocean .order-item-desc,
.theme-ocean .order-item-price {
  color: rgba(180, 220, 255, 0.60);
}

.order-foot {
  margin-top: 22rpx;
}

.pay-btn {
  min-width: 220rpx;
}

.paid-tip {
  color: #6ee7a0;
}

.theme-light .paid-tip {
  color: #07c160;
}

.theme-ocean .paid-tip {
  color: #5cf5c8;
}
