<view class="page-root theme-{{theme}}">
<view class="container order-page">
  <view class="summary-card card theme-{{theme}}">
    <text class="section-title theme-{{theme}}">我的订单</text>
    <text class="section-subtitle theme-{{theme}}">支付成功后会立即发放会员权益或场景生成点数。</text>
    <view class="summary-inline" wx:if="{{me}}">
      <text class="summary-chip theme-{{theme}}">会员：{{me.memberSummary.isActive ? '已开通' : '未开通'}}</text>
      <text class="summary-chip theme-{{theme}}">点数：{{me.creditSummary.sceneGenerateBalance || 0}}</text>
    </view>
    <button class="btn-secondary theme-{{theme}}" bindtap="onOpenProducts">继续购买</button>
  </view>

  <view wx:if="{{loading}}" class="state-card theme-{{theme}}">订单加载中...</view>
  <view wx:elif="{{errorMessage}}" class="state-card theme-{{theme}}">{{errorMessage}}</view>
  <view wx:elif="{{!orders.length}}" class="state-card theme-{{theme}}">还没有订单，先去商品页下单。</view>

  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="orderId" class="order-card card theme-{{theme}}">
      <view class="order-head">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-status theme-{{theme}} order-status-{{item.status}}">{{item.status}}</text>
      </view>
      <view wx:for="{{item.items}}" wx:key="orderItemId" wx:for-item="orderItem" class="order-item theme-{{theme}}">
        <view class="order-item-row">
          <text class="order-item-name">{{orderItem.productName}} / {{orderItem.skuName}}</text>
          <text class="order-item-price theme-{{theme}}">¥{{orderItem.totalPrice}}</text>
        </view>
        <text class="order-item-desc theme-{{theme}}">数量 {{orderItem.quantity}}</text>
      </view>
      <view class="order-foot">
        <text class="order-total">应付 ¥{{item.payableAmount}}</text>
        <button
          wx:if="{{item.status !== 'paid'}}"
          class="btn-primary theme-{{theme}} pay-btn"
          loading="{{payingOrderId === item.orderId}}"
          disabled="{{payingOrderId && payingOrderId !== item.orderId}}"
          bindtap="onPayOrder"
          data-order-id="{{item.orderId}}"
        >
          继续支付
        </button>
        <text wx:else class="paid-tip theme-{{theme}}">已支付</text>
      </view>
    </view>
  </view>
</view>
</view>
