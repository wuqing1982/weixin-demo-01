.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-end));
}

.profile-eyebrow,
.profile-meta {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.profile-name {
  display: block;
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-meta {
  margin-top: 8rpx;
}

.hero {
  padding: 36rpx;
  background: var(--color-surface);
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.logout-btn {
  min-width: 160rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-card {
  padding: 28rpx;
}

.action-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.action-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* Theme switcher */
.theme-section {
  margin: 24rpx 0 0;
  padding: 24rpx;
  background: var(--color-surface);
  border: 1px solid var(--color-surface-border);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.theme-label {
  font-size: var(--font-body);
  color: var(--color-text);
  font-weight: 500;
}

.theme-options {
  display: flex;
  gap: 16rpx;
}

.theme-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-surface-border);
  transition: all 0.2s ease;
}

.theme-opt.active {
  border-color: var(--color-primary);
  background: var(--color-surface);
}

.theme-opt text {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.theme-opt.active text {
  color: var(--color-primary);
  font-weight: 600;
}

.theme-preview {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-surface-border);
}

.dark-preview {
  background: linear-gradient(135deg, #0d1117, #141b24);
}

.light-preview {
  background: linear-gradient(135deg, #f5f6f8, #ebedf0);
}
