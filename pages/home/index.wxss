.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---- Profile Strip — strongly themed ---- */

/* Dark: dark green glass */
.profile-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(14, 50, 43, 0.92), rgba(25, 88, 73, 0.78));
  color: #f5eee0;
}

/* Light: bright WeChat green */
.theme-light .profile-strip {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
}

/* Ocean: deep blue gradient */
.theme-ocean .profile-strip {
  background: linear-gradient(135deg, #0a3d6b, #062d52);
  color: #b0d8ff;
}

.profile-strip .btn-secondary {
  color: #f5eee0;
  border-color: rgba(245, 238, 224, 0.35);
  background: rgba(245, 238, 224, 0.12);
}

.theme-light .profile-strip .btn-secondary {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.50);
  background: rgba(255, 255, 255, 0.22);
}

.theme-ocean .profile-strip .btn-secondary {
  color: #b0d8ff;
  border-color: rgba(100, 180, 255, 0.40);
  background: rgba(100, 180, 255, 0.12);
}

.profile-eyebrow,
.profile-meta {
  display: block;
  font-size: 22rpx;
  color: rgba(245, 238, 224, 0.78);
}

.theme-light .profile-eyebrow,
.theme-light .profile-meta {
  color: rgba(255, 255, 255, 0.85);
}

.theme-ocean .profile-eyebrow,
.theme-ocean .profile-meta {
  color: rgba(176, 216, 255, 0.75);
}

.profile-name {
  display: block;
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-meta {
  margin-top: 8rpx;
}

/* ---- Hero card — thematic atmosphere ---- */

/* Dark: warm green tint */
.hero {
  padding: 36rpx;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.06), rgba(110, 140, 98, 0.10));
}

/* Light: subtle green tint */
.theme-light .hero {
  background: rgba(7, 193, 96, 0.06);
}

/* Ocean: deep blue glow */
.theme-ocean .hero {
  background: linear-gradient(180deg, rgba(0, 140, 255, 0.08), rgba(0, 80, 180, 0.12));
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.logout-btn {
  min-width: 160rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-card {
  padding: 28rpx;
}

.action-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.action-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
}
.theme-light .action-desc { color: #888888; }
.theme-ocean .action-desc { color: rgba(180,220,255,0.65); }

/* ---- Theme switcher ---- */
.theme-section {
  margin: 24rpx 0 0;
  padding: 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* dark */
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.10);
}

/* Light: white card */
.theme-light .theme-section {
  background: #ffffff;
  border: 1px solid #e8e8e8;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

/* Ocean: blue ice */
.theme-ocean .theme-section {
  background: rgba(20,60,120,0.25);
  border: 1px solid rgba(80,160,255,0.22);
}

.theme-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}
.theme-light .theme-label { color: #1a1a1a; }
.theme-ocean .theme-label { color: #e8f4ff; }

.theme-options {
  display: flex;
  gap: 16rpx;
}

.theme-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  /* dark */
  border: 2rpx solid rgba(255,255,255,0.12);
}

.theme-light .theme-opt {
  border-color: #e0e0e0;
  border-radius: 12rpx;
}

.theme-ocean .theme-opt {
  border-color: rgba(80,160,255,0.20);
}

.theme-opt.active {
  /* dark: purple glow */
  border-color: #667eea;
  background: rgba(102,126,234,0.12);
  box-shadow: 0 0 0 2rpx rgba(102,126,234,0.40);
}

.theme-light .theme-opt.active {
  /* light: green */
  border-color: #07c160;
  background: rgba(7,193,96,0.08);
  box-shadow: 0 0 0 2rpx rgba(7,193,96,0.30);
}

.theme-ocean .theme-opt.active {
  /* ocean: cyan glow */
  border-color: #00b8ff;
  background: rgba(0,184,255,0.12);
  box-shadow: 0 0 0 2rpx rgba(0,184,255,0.40);
}

.theme-opt text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.60);
}
.theme-light .theme-opt text { color: #888888; }
.theme-ocean .theme-opt text { color: rgba(180,220,255,0.60); }

.theme-opt.active text {
  font-weight: 600;
  color: #667eea;
}
.theme-light .theme-opt.active text { color: #07c160; }
.theme-ocean .theme-opt.active text { color: #00b8ff; }

.theme-preview {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  position: relative;
  border: 3rpx solid rgba(255,255,255,0.12);
}
.theme-light .theme-preview { border-color: #e0e0e0; }
.theme-ocean .theme-preview { border-color: rgba(80,160,255,0.20); }

.theme-opt.active .theme-preview {
  border-color: #667eea;
}
.theme-light .theme-opt.active .theme-preview { border-color: #07c160; }
.theme-ocean .theme-opt.active .theme-preview { border-color: #00b8ff; }

.dark-preview {
  background: linear-gradient(135deg, #0b0b0c, #121318);
  box-shadow: inset 0 0 10rpx rgba(102, 126, 234, 0.35);
}

.light-preview {
  background: linear-gradient(135deg, #f5f6f8, #ebedf0);
  box-shadow: inset 0 0 8rpx rgba(7, 193, 96, 0.2);
}

.ocean-preview {
  background: linear-gradient(135deg, #041526, #0a2540);
  box-shadow: inset 0 0 8rpx rgba(0, 184, 246, 0.3);
}
