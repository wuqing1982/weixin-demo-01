.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(14, 50, 43, 0.92), rgba(25, 88, 73, 0.78));
  color: #f5eee0;
}

.theme-light .profile-strip {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
}

.theme-ocean .profile-strip {
  background: linear-gradient(135deg, rgba(30, 70, 130, 0.92), rgba(20, 55, 100, 0.85));
  color: #e3f2fd;
}

.profile-strip .btn-secondary {
  color: #f5eee0;
  border-color: rgba(245, 238, 224, 0.35);
  background: rgba(245, 238, 224, 0.12);
}

.theme-light .profile-strip .btn-secondary {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.40);
  background: rgba(255, 255, 255, 0.18);
}

.theme-ocean .profile-strip .btn-secondary {
  color: #e3f2fd;
  border-color: rgba(227, 242, 253, 0.35);
  background: rgba(227, 242, 253, 0.12);
}

.profile-eyebrow,
.profile-meta {
  display: block;
  font-size: 22rpx;
  color: rgba(245, 238, 224, 0.78);
}

.theme-light .profile-eyebrow,
.theme-light .profile-meta {
  color: rgba(255, 255, 255, 0.85);
}

.theme-ocean .profile-eyebrow,
.theme-ocean .profile-meta {
  color: rgba(227, 242, 253, 0.78);
}

.profile-name {
  display: block;
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-meta {
  margin-top: 8rpx;
}

.hero {
  padding: 36rpx;
  background: linear-gradient(180deg, rgba(255, 248, 236, 0.08), rgba(110, 140, 98, 0.12));
}

.theme-light .hero {
  background: linear-gradient(180deg, rgba(7, 193, 96, 0.06), rgba(7, 193, 96, 0.12));
}

.theme-ocean .hero {
  background: linear-gradient(180deg, rgba(100, 181, 246, 0.08), rgba(66, 165, 245, 0.14));
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.logout-btn {
  min-width: 160rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-card {
  padding: 28rpx;
}

.action-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.action-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  /* dark */
  color: rgba(255,255,255,0.72);
}
.theme-light .action-desc { color: #666666; }
.theme-ocean .action-desc { color: rgba(227,242,253,0.70); }

/* Theme switcher */
.theme-section {
  margin: 24rpx 0 0;
  padding: 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* dark */
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.14);
}
.theme-light .theme-section {
  background: #f0f0f2;
  border-color: #e0e0e0;
}
.theme-ocean .theme-section {
  background: rgba(100,180,255,0.10);
  border-color: rgba(100,180,255,0.18);
}

.theme-label {
  font-size: 28rpx;
  font-weight: 500;
  /* dark */
  color: #ffffff;
}
.theme-light .theme-label { color: #191919; }
.theme-ocean .theme-label { color: #e3f2fd; }

.theme-options {
  display: flex;
  gap: 16rpx;
}

.theme-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  /* dark */
  border: 2rpx solid rgba(255,255,255,0.14);
}
.theme-light .theme-opt { border-color: #e0e0e0; }
.theme-ocean .theme-opt { border-color: rgba(100,180,255,0.18); }

.theme-opt.active {
  /* dark */
  border-color: #667eea;
  background: rgba(255,255,255,0.12);
  box-shadow: 0 0 0 2rpx #667eea;
}
.theme-light .theme-opt.active {
  border-color: #07c160;
  background: rgba(7,193,96,0.08);
  box-shadow: 0 0 0 2rpx #07c160;
}
.theme-ocean .theme-opt.active {
  border-color: #64b5f6;
  background: rgba(100,181,246,0.12);
  box-shadow: 0 0 0 2rpx #64b5f6;
}

.theme-opt text {
  font-size: 24rpx;
  /* dark */
  color: rgba(255,255,255,0.72);
}
.theme-light .theme-opt text { color: #666666; }
.theme-ocean .theme-opt text { color: rgba(227,242,253,0.70); }

.theme-opt.active text {
  font-weight: 600;
  /* dark */
  color: #667eea;
}
.theme-light .theme-opt.active text { color: #07c160; }
.theme-ocean .theme-opt.active text { color: #64b5f6; }

.theme-preview {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  position: relative;
  /* dark */
  border: 3rpx solid rgba(255,255,255,0.14);
}
.theme-light .theme-preview { border-color: #e0e0e0; }
.theme-ocean .theme-preview { border-color: rgba(100,180,255,0.18); }

.theme-opt.active .theme-preview {
  border-color: #667eea;
}
.theme-light .theme-opt.active .theme-preview { border-color: #07c160; }
.theme-ocean .theme-opt.active .theme-preview { border-color: #64b5f6; }

.dark-preview {
  background: linear-gradient(135deg, #0b0b0c, #121318);
  box-shadow: inset 0 0 10rpx rgba(102, 126, 234, 0.35);
}

.light-preview {
  background: linear-gradient(135deg, #f5f6f8, #ebedf0);
  box-shadow: inset 0 0 8rpx rgba(7, 193, 96, 0.2);
}

.ocean-preview {
  background: linear-gradient(135deg, #0a192f, #0d2137);
  box-shadow: inset 0 0 8rpx rgba(100, 181, 246, 0.3);
}
