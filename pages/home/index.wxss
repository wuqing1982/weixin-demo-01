.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  padding: 36rpx;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-card {
  padding: 28rpx;
}

.action-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.action-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}
