<view class="page-root {{theme}}">
<view class="container home-page">
  <view class="profile-strip card" wx:if="{{me}}">
    <view>
      <text class="profile-eyebrow">已登录会员中心</text>
      <text class="profile-name">{{me.displayName || '微信用户'}}</text>
      <text class="profile-meta">身份：{{me.isAdmin ? 'Admin' : '普通用户'}} · 会员：{{me.memberSummary.isActive ? '已开通' : '未开通'}} · 点数：{{me.creditSummary.sceneGenerateBalance || 0}}</text>
    </view>
    <button class="btn-secondary logout-btn" bindtap="onLogout">退出</button>
  </view>

  <!-- Theme switcher -->
  <view class="theme-section">
    <text class="theme-label">外观主题</text>
    <view class="theme-options">
      <view class="theme-opt {{theme === 'dark' ? 'active' : ''}}" bindtap="switchTheme" data-theme="dark">
        <view class="theme-preview dark-preview"></view>
        <text>暗色</text>
      </view>
      <view class="theme-opt {{theme === 'light' ? 'active' : ''}}" bindtap="switchTheme" data-theme="light">
        <view class="theme-preview light-preview"></view>
        <text>浅色</text>
      </view>
      <view class="theme-opt {{theme === 'ocean' ? 'active' : ''}}" bindtap="switchTheme" data-theme="ocean">
        <view class="theme-preview ocean-preview"></view>
        <text>海洋</text>
      </view>
    </view>
  </view>

  <view class="hero card">
    <text class="section-title">英语场景会员中心</text>
    <text class="section-subtitle">真实微信登录、会员商品、订单、我的场景和热点编辑已经接到同一条业务链路里。</text>
    <view class="hero-actions">
      <button class="btn-primary" bindtap="onOpen" data-url="/pages/products/index">购买会员</button>
      <button class="btn-secondary" bindtap="onOpen" data-url="/pages/orders/index">查看订单</button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="state-card">{{errorMessage}}</view>

  <view class="action-list">
    <view wx:for="{{actions}}" wx:key="id" class="action-card card" bindtap="onOpen" data-url="{{item.url}}">
      <text class="action-title">{{item.title}}</text>
      <text class="action-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
</view>
