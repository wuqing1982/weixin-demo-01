<view class="page-root theme-{{theme}}">
<view class="container home-page">
  <view class="profile-strip card theme-{{theme}}" wx:if="{{me}}">
    <view>
      <text class="profile-eyebrow theme-{{theme}}">已登录会员中心</text>
      <text class="profile-name">{{me.displayName || '微信用户'}}</text>
      <view class="profile-meta-row">
        <text class="profile-meta theme-{{theme}}">身份：{{me.isAdmin ? 'Admin' : '普通用户'}}</text>
        <text class="profile-badge {{me.memberSummary.isActive ? 'badge-tier badge-' + me.memberSummary.entitlementCode : 'badge-inactive'}}">{{memberTierLabel}}</text>
        <text class="profile-meta theme-{{theme}}">点数：{{me.creditSummary.sceneGenerateBalance || 0}}</text>
      </view>
    </view>
    <button class="btn-secondary logout-btn theme-{{theme}}" bindtap="onLogout">退出</button>
  </view>

  <!-- Theme switcher -->
  <view class="theme-section theme-{{theme}}">
    <text class="theme-label theme-{{theme}}">外观主题</text>
    <view class="theme-options">
      <view class="theme-opt theme-{{theme}} {{theme === 'dark' ? 'active' : ''}}" bindtap="switchTheme" data-theme="dark">
        <view class="theme-preview dark-preview theme-{{theme}}"></view>
        <text>暗色</text>
      </view>
      <view class="theme-opt theme-{{theme}} {{theme === 'light' ? 'active theme-opt-active-light' : ''}}" bindtap="switchTheme" data-theme="light">
        <view class="theme-preview light-preview theme-{{theme}}"></view>
        <text>浅色</text>
      </view>
      <view class="theme-opt theme-{{theme}} {{theme === 'ocean' ? 'active theme-opt-active-ocean' : ''}}" bindtap="switchTheme" data-theme="ocean">
        <view class="theme-preview ocean-preview theme-{{theme}}"></view>
        <text>海洋</text>
      </view>
    </view>
  </view>

  <view class="hero card theme-{{theme}}">
    <text class="section-title theme-{{theme}}">英语场景会员中心</text>
    <text class="section-subtitle theme-{{theme}}">真实微信登录、会员商品、订单、我的场景和热点编辑已经接到同一条业务链路里。</text>
    <view class="hero-actions">
      <button class="btn-primary theme-{{theme}}" bindtap="onOpen" data-url="/pages/products/index">购买会员</button>
      <button class="btn-secondary theme-{{theme}}" bindtap="onOpen" data-url="/pages/orders/index">查看订单</button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="state-card theme-{{theme}}">{{errorMessage}}</view>

  <view class="action-list">
    <view wx:for="{{actions}}" wx:key="id" class="action-card card theme-{{theme}}" bindtap="onOpen" data-url="{{item.url}}">
      <text class="action-title">{{item.title}}</text>
      <text class="action-desc theme-{{theme}}">{{item.desc}}</text>
    </view>
  </view>
</view>
</view>
