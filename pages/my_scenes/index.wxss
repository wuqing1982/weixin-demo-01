.create-btn {
  margin-top: 24rpx;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.scene-card {
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.scene-meta {
  padding: 24rpx;
}

.scene-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.scene-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}
