.create-btn {
  margin-top: 24rpx;
}

/* ---- Top actions row ---- */

.top-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.top-actions .create-btn {
  flex: 1;
  margin-top: 0;
}

.manage-btn {
  flex-shrink: 0;
  padding: 0 32rpx !important;
  margin-top: 0 !important;
  min-width: 120rpx;
}

/* ---- Category filter ---- */

.section-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff !important;
}
.section-heading.theme-notion { color: rgba(0,0,0,0.95) !important; }

.filter-scroll {
  width: 100%;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
  padding-bottom: 4rpx;
}

.filter-chip {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
  background: rgba(255,255,255,0.07) !important;
  color: rgba(255,255,255,0.60) !important;
}

.filter-chip.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  color: #615d59 !important;
  border-radius: 999rpx;
}

.filter-chip-active {
  background: rgba(126, 240, 191, 0.16) !important;
  border-color: transparent !important;
  color: #d8fff0 !important;
}

.filter-chip-active.theme-notion {
  background: #0075de !important;
  border-color: transparent !important;
  color: #ffffff !important;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.scene-card {
  overflow: hidden;
  position: relative;
}

.scene-cover {
  width: 100%;
  height: 280rpx;
  display: block;
}

.scene-meta {
  padding: 24rpx;
}

.scene-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.scene-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.60) !important;
}
.scene-desc.theme-notion { color: #615d59 !important; }

/* ---- Dual-column grid layout ---- */

.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.scene-cover-grid {
  height: 200rpx;
}

.scene-meta-grid {
  padding: 16rpx;
}

.scene-title-grid {
  font-size: 26rpx;
}

/* ---- Section header with toggle ---- */

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.view-toggle {
  padding: 12rpx 16rpx;
}

.toggle-icon {
  font-size: 36rpx;
  opacity: 0.6;
}

/* ---- End-of-list tip ---- */

.list-end-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.40) !important;
}
.list-end-tip.theme-notion { color: #a39e98 !important; }

/* ---- Pagination bar ---- */

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0;
}

.page-num {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.07) !important;
  color: rgba(255,255,255,0.60) !important;
}

.page-num.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  color: #615d59 !important;
}

.page-num-active {
  background: rgba(126, 240, 191, 0.16) !important;
  color: #d8fff0 !important;
}

.page-num-active.theme-notion {
  background: #0075de !important;
  color: #ffffff !important;
}

.page-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  color: rgba(255,255,255,0.50) !important;
}

.page-btn.theme-notion { color: #a39e98 !important; }

.page-btn-disabled {
  opacity: 0.3;
}

/* ---- Edit mode toolbar ---- */

.edit-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-top: 16rpx;
}

.edit-toolbar-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edit-toolbar-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.80) !important;
}
.edit-toolbar-text.theme-notion { color: rgba(0,0,0,0.80) !important; }

.edit-toolbar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-count {
  font-size: 24rpx;
  color: rgba(255,255,255,0.50) !important;
}
.selected-count.theme-notion { color: #a39e98 !important; }

.btn-delete {
  background: #fa5151 !important;
  color: #ffffff !important;
  font-size: 24rpx;
  padding: 0 32rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  border: none;
}

.btn-delete-disabled {
  opacity: 0.4;
}

.btn-cancel {
  background: rgba(255,255,255,0.10) !important;
  color: rgba(255,255,255,0.80) !important;
  font-size: 24rpx;
  padding: 0 20rpx !important;
  min-width: 0;
  flex: 0 0 auto;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  border: none;
  text-align: left;
}
.btn-cancel.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  color: #615d59 !important;
}

/* ---- Checkbox (toolbar) ---- */

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.checkbox.theme-notion { border-color: rgba(0,0,0,0.20); }

.checkbox-checked {
  background: #0075de !important;
  border-color: #0075de !important;
}

.checkbox-tick {
  width: 12rpx;
  height: 20rpx;
  border: solid #ffffff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
  margin-top: -4rpx;
}

/* ---- Select checkbox on card ---- */

.select-checkbox {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.50);
  background: rgba(0,0,0,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  box-sizing: border-box;
}

.select-checkbox-checked {
  background: #0075de !important;
  border-color: #0075de !important;
}

.checkbox-tick-white {
  width: 14rpx;
  height: 22rpx;
  border: solid #ffffff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
  margin-top: -4rpx;
}

/* ---- Card selected state ---- */

.scene-card-selected {
  box-shadow: 0 0 0 3rpx #0075de;
}
