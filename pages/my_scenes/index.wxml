<view class="page-root theme-{{theme}}">
<view class="container">
  <text class="section-title theme-{{theme}}">我的生成场景</text>
  <text class="section-subtitle theme-{{theme}}">这里只展示当前调试用户上传并生成成功的私人场景。</text>
  <button class="btn-secondary theme-{{theme}} create-btn" bindtap="onOpenCreate">继续生成新场景</button>

  <view wx:if="{{loading}}" class="state-card theme-{{theme}}">加载我的场景中...</view>

  <view wx:elif="{{errorMessage}}" class="state-card theme-{{theme}}">{{errorMessage}}</view>

  <view wx:elif="{{!scenes.length}}" class="state-card theme-{{theme}}">还没有生成成功的私人场景，先去上传一张图片。</view>

  <view wx:else class="scene-list">
    <view
      wx:for="{{scenes}}"
      wx:key="sceneId"
      class="scene-card card theme-{{theme}}"
      bindtap="onOpenScene"
      data-scene-id="{{item.sceneId}}"
    >
      <image class="scene-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="scene-meta">
        <text class="scene-title">{{item.title}}</text>
        <text class="scene-desc theme-{{theme}}">{{item.category || 'generated'}} · {{item.visibility}}</text>
      </view>
    </view>
  </view>
</view>
</view>
