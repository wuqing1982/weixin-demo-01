<template name="scenePage">
  <view
    class="scene-page"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
  >
    <view class="scene-stage">
      <view class="scene-topbar">
        <view class="scene-title-block">
          <text class="scene-title">{{title}}</text>
          <text class="scene-subtitle">左右滑动切换场景</text>
        </view>

        <view class="scene-nav">
          <button
            class="scene-nav-btn"
            bindtap="onTapPrevScene"
            disabled="{{!prevScene}}"
          >‹</button>
          <button
            class="scene-nav-btn"
            bindtap="onTapNextScene"
            disabled="{{!nextScene}}"
          >›</button>
        </view>
      </view>

      <view class="scene-pager">
        <view
          wx:for="{{sceneTabs}}"
          wx:key="sceneId"
          class="scene-pill {{item.sceneId === sceneId ? 'scene-pill-active' : ''}}"
          data-scene-id="{{item.sceneId}}"
          bindtap="onTapScenePill"
        >
          {{item.title}}
        </view>
      </view>

      <view class="scene-frame {{verbs.length ? 'scene-frame-has-verbs' : ''}}">
        <view class="scene-content">
          <image
            class="scene-bg"
            src="{{background}}"
            mode="aspectFill"
          />

          <view class="scene-hotspots">
            <view
              wx:for="{{items}}"
              wx:key="id"
              class="zone {{activeType === 'item' && activeId === item.id ? 'zone-active' : ''}}"
              style="left: {{item.rect.l}}%; top: {{item.rect.t}}%; width: {{item.rect.w}}%; height: {{item.rect.h}}%;"
              data-id="{{item.id}}"
              bindtap="onTapHotspot"
            >
              <view class="zone-dot"></view>
            </view>
          </view>

          <view class="overlay {{activeEntry ? 'overlay-visible' : ''}}">
            <view class="overlay-header">
              <view class="overlay-title-wrap">
                <text class="word">{{activeEntry ? activeEntry.word : '点击热点开始学习'}}</text>
                <text class="ipa">{{activeEntry ? activeEntry.ipa : ''}}</text>
              </view>
              <button
                wx:if="{{activeEntry}}"
                class="overlay-close"
                bindtap="onCloseOverlay"
              >×</button>
            </view>

            <view wx:if="{{activeEntry}}">
              <text class="meaning">{{activeEntry.meaning}}</text>
              <text class="sentence">{{activeEntry.sentence}}</text>
              <text class="translation">{{activeEntry.sentenceTranslation}}</text>
            </view>

            <view wx:else>
              <text class="placeholder">点击图片中的热点，查看单词并播放音频。</text>
            </view>
          </view>

          <view wx:if="{{verbs.length}}" class="verb-strip">
            <view
              wx:for="{{verbs}}"
              wx:key="id"
              class="verb-chip {{activeType === 'verb' && activeId === item.id ? 'verb-chip-active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onTapVerb"
            >
              {{item.word}}
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>
