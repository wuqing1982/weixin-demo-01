<template name="scenePage">
  <view
    class="scene-page"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
  >
    <view wx:if="{{loading}}" class="state-card">场景加载中...</view>

    <view wx:elif="{{errorMessage}}" class="state-card">{{errorMessage}}</view>

    <view wx:else class="scene-stage">
      <!-- 顶部工具栏 -->
      <view class="scene-toolbar">
        <view wx:if="{{canEditHotspots}}" class="toolbar-group editor-mode-group">
          <view
            class="mode-dot mode-dot-edit {{editorMode ? 'mode-dot-active' : 'mode-dot-inactive'}}"
            bindtap="onEnterEditorMode"
            title="编辑态"
          ></view>
          <view
            class="mode-dot mode-dot-browse {{!editorMode ? 'mode-dot-active' : 'mode-dot-inactive'}}"
            bindtap="onExitEditorMode"
            title="浏览态"
          ></view>
        </view>

        <!-- 语速控制 -->
        <view class="toolbar-group rate-group">
          <view class="rate-control-row">
            <view 
              class="rate-icon {{playbackRate <= 0.8 ? 'active' : ''}}"
              bindtap="onRatePreset"
              data-rate="0.75"
              title="慢速"
            >🐢</view>

            <slider 
              class="rate-slider"
              min="0.5"
              max="2"
              step="0.1"
              value="{{playbackRate}}"
              bindchange="onRateChange"
              block-size="14"
              backgroundColor="rgba(255,255,255,0.25)"
              activeColor="#667eea"
            />

            <view 
              class="rate-icon {{playbackRate >= 1.2 ? 'active' : ''}}"
              bindtap="onRatePreset"
              data-rate="1.5"
              title="快速"
            >🐇</view>
          </view>
          <text class="rate-display">{{playbackRate}}x</text>
        </view>

        <view 
          class="toolbar-btn repeat-btn {{isLooping ? 'active' : ''}}"
          bindtap="onToggleLoop"
          title="重复播放"
        >🔄</view>

        <view 
          class="toolbar-btn camera-btn"
          bindtap="onOpenCamera"
          title="摄像头"
        >📷</view>

        <view 
          class="toolbar-btn export-btn"
          bindtap="onExportVideo"
          title="导出视频"
        >🎬</view>

      </view>

      <view class="scene-frame-wrapper">
        <view class="scene-frame {{verbs.length ? 'scene-frame-has-verbs' : ''}}">
          <view class="scene-content" id="sceneContent">
            <image
              class="scene-bg"
              src="{{background}}"
              mode="aspectFill"
            />

            <view wx:if="{{!editorMode}}" class="scene-hotspots scene-hotspots-browse">
              <view
                wx:for="{{items}}"
                wx:key="id"
                class="zone {{activeType === 'item' && activeId === item.id ? 'zone-active' : ''}}"
                style="left: {{item.rect.l}}%; top: {{item.rect.t}}%; width: {{item.rect.w}}%; height: {{item.rect.h}}%;"
                data-id="{{item.id}}"
                catchtap="onTapHotspot"
              >
                <view class="zone-dot"></view>
              </view>
            </view>

            <view wx:if="{{editorMode}}" class="scene-hotspots scene-hotspots-editor">
              <view
                wx:for="{{hotspotItems}}"
                wx:key="id"
                class="zone zone-editor {{editingItemId === item.id ? 'zone-editor-active' : ''}}"
                style="left: {{item.rect.l}}%; top: {{item.rect.t}}%; width: {{item.rect.w}}%; height: {{item.rect.h}}%;"
                data-id="{{item.id}}"
                catchtap="onTapHotspot"
                catchtouchstart="onEditorZoneTouchStart"
                catchtouchmove="onEditorZoneTouchMove"
                catchtouchend="onEditorZoneTouchEnd"
              >
                <view class="zone-dot"></view>
                <block wx:if="{{editingItemId === item.id}}">
                  <view class="zone-label">{{item.word}}</view>
                  <view class="zone-handle zone-handle-nw" data-id="{{item.id}}" data-handle="nw" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                  <view class="zone-handle zone-handle-n" data-id="{{item.id}}" data-handle="n" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                  <view class="zone-handle zone-handle-ne" data-id="{{item.id}}" data-handle="ne" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                  <view class="zone-handle zone-handle-e" data-id="{{item.id}}" data-handle="e" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                  <view class="zone-handle zone-handle-se" data-id="{{item.id}}" data-handle="se" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                  <view class="zone-handle zone-handle-s" data-id="{{item.id}}" data-handle="s" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                  <view class="zone-handle zone-handle-sw" data-id="{{item.id}}" data-handle="sw" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                  <view class="zone-handle zone-handle-w" data-id="{{item.id}}" data-handle="w" catchtouchstart="onEditorHandleTouchStart" catchtouchmove="onEditorZoneTouchMove" catchtouchend="onEditorZoneTouchEnd"></view>
                </block>
              </view>
            </view>

            <view
              wx:if="{{editorMode}}"
              class="floating-save-btn {{isDirty ? 'floating-save-btn-dirty' : ''}} {{isSaving ? 'floating-save-btn-saving' : ''}}"
              style="left: {{saveButtonPosition.x}}%; top: {{saveButtonPosition.y}}%;"
              catchtap="onTapFloatingSave"
              catchtouchstart="onSaveButtonTouchStart"
              catchtouchmove="onSaveButtonTouchMove"
              catchtouchend="onSaveButtonTouchEnd"
            >
              <text class="floating-save-text">{{isSaving ? '保存中' : '保存'}}</text>
            </view>

            <view wx:if="{{!editorMode}}" class="overlay {{activeEntry ? 'overlay-visible' : ''}}">
              <view class="overlay-header">
                <view class="overlay-title-wrap">
                  <text class="word">{{activeEntry ? activeEntry.word : ''}}</text> 
                  <text class="ipa">{{activeEntry ? activeEntry.ipa : ''}}</text>
                </view>
                <button
                  wx:if="{{activeEntry}}"
                  class="overlay-close"
                  bindtap="onCloseOverlay"
                >×</button>
              </view>

              <view wx:if="{{activeEntry}}">
                <text class="meaning">{{activeEntry.meaning}}</text>
                <text class="sentence">{{activeEntry.sentence}}</text>
                <text class="translation">{{activeEntry.sentenceTranslation}}</text>
              </view>
            </view>

            <view wx:if="{{verbs.length && !editorMode}}" class="verb-strip">
              <view
                wx:for="{{verbs}}"
                wx:key="id"
                class="verb-chip {{activeType === 'verb' && activeId === item.id ? 'verb-chip-active' : ''}}"
                data-id="{{item.id}}"
                bindtap="onTapVerb"
              >
                {{item.word}}
              </view>
            </view>

            <view wx:if="{{editorMode}}" class="editor-panel">
              <view class="editor-panel-header">
                <view class="editor-panel-copy">
                  <text class="editor-panel-title">{{editingEntry ? editingEntry.word : '选择热点'}}</text>
                  <text class="editor-panel-subtitle">{{isDirty ? '有未保存改动' : '拖动热点或用按钮微调'}}</text>
                </view>
              </view>

              <view wx:if="{{editingEntry}}" class="editor-actions">
                <view class="editor-grid">
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dt="-1">上移</button>
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dl="-1">左移</button>
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dl="1">右移</button>
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dt="1">下移</button>
                </view>

                <view class="editor-grid editor-grid-size">
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dw="-1">变窄</button>
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dw="1">变宽</button>
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dh="-1">变矮</button>
                  <button class="editor-mini-btn" bindtap="onEditorNudge" data-dh="1">变高</button>
                </view>

                <button class="editor-reset-btn" bindtap="onEditorResetCurrent">重置当前热点</button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>
