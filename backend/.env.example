# Public URLs
PUBLIC_BASE_URL=https://e.cps.vin

# PostgreSQL
DATABASE_URL=postgresql://weixin_saas:replace_me@localhost:5432/weixin_saas

# Auth
AUTH_ENABLE_DEBUG_USER_HEADER=true
AUTH_WECHAT_LOGIN_MODE=mock
AUTH_JWT_SECRET=dev-jwt-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=7200
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Worker
ENABLE_INLINE_SCENE_WORKER=true
WORKER_POLL_INTERVAL=2

# core100 / TTS
CORE100_ROOT=/www/wwwroot/e.cps.vin/core100
CORE100_MODEL=glm-4v-flash
CORE100_TTS_URL=http://127.0.0.1:5003
ZHIPUAI_API_KEY=

# Hotspot editor
HOTSPOT_EDITOR_ENABLED=true
HOTSPOT_EDITOR_ADMIN_USER_IDS=
HOTSPOT_EDITOR_PUBLIC_EDITOR_IDS=*
HOTSPOT_EDITOR_PRIVATE_EDITOR_IDS=*
