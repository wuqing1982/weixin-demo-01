page {
  min-height: 100%;
  background: linear-gradient(180deg, #0b0b0c 0%, #121318 100%);
  color: #ffffff;
}

view,
text,
button,
image,
input,
scroll-view,
textarea {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
}

.card,
.state-card {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.state-card {
  margin: 28rpx 20rpx 0;
  padding: 32rpx 28rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.82);
  text-align: center;
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.section-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.btn-primary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn-primary {
  border: 0;
  background: linear-gradient(135deg, #667eea, #7c5cd6);
  color: #ffffff;
  font-weight: 600;
}

.btn-secondary {
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
}

.btn-primary::after,
.btn-secondary::after {
  border: 0;
}

/* Loading spinner */
.loading-spinner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner .spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-spinner .loading-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state .empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
}

.empty-state .empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.25);
}

/* List footer */
.list-footer {
  text-align: center;
  padding: 24rpx 0 40rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* Safe area bottom padding */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
