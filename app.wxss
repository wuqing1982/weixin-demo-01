/* ================================================================
   Design Tokens — spacing, radius, font (theme-independent)
   ================================================================ */
page {
  --space-xs:  8rpx;
  --space-sm:  16rpx;
  --space-md:  20rpx;
  --space-lg:  24rpx;
  --space-xl:  32rpx;

  --radius-sm:  12rpx;
  --radius-md:  16rpx;
  --radius-lg:  24rpx;
  --radius-pill: 999rpx;

  --font-title:   40rpx;
  --font-heading: 32rpx;
  --font-body:    28rpx;
  --font-caption: 24rpx;
  --font-badge:   22rpx;

  /* page background: dark default */
  background: linear-gradient(180deg, #0b0b0c 0%, #121318 100%);
  color: #ffffff;
  min-height: 100%;
}

/* NOTE: page element cannot receive dynamic theme classes.
   The <view class="page-root {{theme}}>"> inside page handles theming.
   page {} keeps dark as the permanent default. */

/* ================================================================
   Global reset
   ================================================================ */
view,
text,
button,
image,
input,
scroll-view,
textarea {
  box-sizing: border-box;
}

/* ================================================================
   Layout — .page-root has BOTH page-root and theme-xxx classes
   ================================================================ */
.page-root {
  min-height: 100vh;
  background: linear-gradient(180deg, #0b0b0c 0%, #121318 100%);
  color: #ffffff;
}

/* .theme-light and .theme-ocean are on the SAME element as .page-root,
   so they can override .page-root's background directly. */

.theme-light {
  background: linear-gradient(180deg, #f5f6f8 0%, #ebedf0 100%) !important;
  color: #191919 !important;
}

.theme-ocean {
  background: linear-gradient(180deg, #0a192f 0%, #0d2137 100%) !important;
  color: #e3f2fd !important;
}

.container {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
}

/* ================================================================
   Card — dark default + light/ocean overrides
   ================================================================ */
.card,
.state-card {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.18);
}

.theme-light .card,
.theme-light .state-card {
  background: #ffffff;
  border: 1px solid #e0e0e0;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.10);
}

.theme-ocean .card,
.theme-ocean .state-card {
  background: rgba(100,180,255,0.08);
  border: 1px solid rgba(100,180,255,0.18);
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.30);
}

.state-card {
  margin: 28rpx 20rpx 0;
  padding: 32rpx 28rpx;
  font-size: var(--font-body);
  text-align: center;
}

/* dark */
.state-card {
  color: rgba(255,255,255,0.72);
}
.theme-light .state-card {
  color: #666666;
}
.theme-ocean .state-card {
  color: rgba(227,242,253,0.70);
}

/* ================================================================
   Typography
   ================================================================ */
.section-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: #ffffff;
}
.theme-light .section-title { color: #191919; }
.theme-ocean .section-title { color: #e3f2fd; }

.section-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-caption);
}
/* dark */
.section-subtitle { color: rgba(255,255,255,0.72); }
.theme-light .section-subtitle { color: #666666; }
.theme-ocean .section-subtitle { color: rgba(227,242,253,0.70); }

/* ================================================================
   Buttons — base shared styles
   ================================================================ */
.btn-primary,
.btn-secondary,
.btn-success,
.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 var(--space-xl);
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-primary::after,
.btn-secondary::after,
.btn-success::after,
.btn-danger::after {
  border: 0;
}

.btn-primary:active,
.btn-secondary:active,
.btn-success:active,
.btn-danger:active {
  transform: scale(0.98);
}

.btn-primary[disabled],
.btn-secondary[disabled],
.btn-success[disabled],
.btn-danger[disabled] {
  opacity: 0.45;
}

/* Primary button — dark */
.btn-primary {
  border: 0;
  background: linear-gradient(135deg, #667eea, #7c5cd6);
  color: #ffffff;
  font-weight: 600;
}
.theme-light .btn-primary {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
}
.theme-ocean .btn-primary {
  background: linear-gradient(135deg, #64b5f6, #42a5f5);
  color: #ffffff;
}

/* Secondary button — dark */
.btn-secondary {
  border: 1px solid rgba(255,255,255,0.18);
  background: rgba(255,255,255,0.08);
  color: #ffffff;
}
.theme-light .btn-secondary {
  border: 1px solid #d0d0d0;
  background: #f0f0f2;
  color: #191919;
}
.theme-ocean .btn-secondary {
  border: 1px solid rgba(100,180,255,0.22);
  background: rgba(100,180,255,0.10);
  color: #e3f2fd;
}

/* Success button — dark */
.btn-success {
  border: 0;
  background: linear-gradient(135deg, #4ade80, #22c55e);
  color: #ffffff;
  font-weight: 600;
}
.theme-light .btn-success {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
}
.theme-ocean .btn-success {
  background: linear-gradient(135deg, #4dd0e1, #26c6da);
  color: #ffffff;
}

/* Danger button — dark */
.btn-danger {
  border: 0;
  background: linear-gradient(135deg, #f87171, #ef4444);
  color: #ffffff;
  font-weight: 600;
}
.theme-light .btn-danger {
  background: linear-gradient(135deg, #fa5151, #e6363a);
  color: #ffffff;
}
.theme-ocean .btn-danger {
  background: linear-gradient(135deg, #ef5350, #e53935);
  color: #ffffff;
}

/* Small variant */
.btn-sm {
  height: 56rpx;
  font-size: var(--font-caption);
  padding: 0 var(--space-lg);
}

/* ================================================================
   Tags
   ================================================================ */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-badge);
}

.tag-primary {
  background: rgba(102,126,234,0.15);
  color: #667eea;
}
.theme-light .tag-primary {
  background: rgba(7,193,96,0.12);
  color: #07c160;
}
.theme-ocean .tag-primary {
  background: rgba(100,181,246,0.15);
  color: #64b5f6;
}

.tag-success {
  background: rgba(74,222,128,0.15);
  color: #4ade80;
}
.theme-light .tag-success {
  background: rgba(7,193,96,0.12);
  color: #07c160;
}
.theme-ocean .tag-success {
  background: rgba(77,208,225,0.15);
  color: #4dd0e1;
}

.tag-warning {
  background: rgba(251,191,36,0.15);
  color: #fbbf24;
}
.theme-light .tag-warning {
  background: rgba(237,106,12,0.12);
  color: #ed6a0c;
}
.theme-ocean .tag-warning {
  background: rgba(255,183,77,0.15);
  color: #ffb74d;
}

.tag-danger {
  background: rgba(248,113,113,0.15);
  color: #f87171;
}
.theme-light .tag-danger {
  background: rgba(250,81,81,0.12);
  color: #fa5151;
}
.theme-ocean .tag-danger {
  background: rgba(239,83,80,0.15);
  color: #ef5350;
}

/* ================================================================
   Badges
   ================================================================ */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-badge);
  font-weight: 600;
}

.badge-success {
  background: #4ade80;
  color: #ffffff;
}
.theme-light .badge-success { background: #07c160; }
.theme-ocean .badge-success { background: #4dd0e1; }

.badge-primary {
  background: #667eea;
  color: #ffffff;
}
.theme-light .badge-primary { background: #07c160; }
.theme-ocean .badge-primary { background: #64b5f6; }

.badge-pending {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.72);
  border: 1px solid rgba(255,255,255,0.14);
}
.theme-light .badge-pending {
  background: #f0f0f2;
  color: #666666;
  border: 1px solid #e0e0e0;
}
.theme-ocean .badge-pending {
  background: rgba(100,180,255,0.10);
  color: rgba(227,242,253,0.70);
  border: 1px solid rgba(100,180,255,0.18);
}

/* ================================================================
   Input
   ================================================================ */
.input-field {
  border-radius: var(--radius-md);
  height: 80rpx;
  padding: 0 var(--space-lg);
  font-size: var(--font-body);
  /* dark */
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.18);
  color: #ffffff;
}
.theme-light .input-field {
  background: #f0f0f2;
  border: 1px solid #d0d0d0;
  color: #191919;
}
.theme-ocean .input-field {
  background: rgba(100,180,255,0.10);
  border: 1px solid rgba(100,180,255,0.22);
  color: #e3f2fd;
}

/* ================================================================
   Loading spinner
   ================================================================ */
.loading-spinner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner .spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.14);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.theme-light .loading-spinner .spinner {
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
}
.theme-ocean .loading-spinner .spinner {
  border: 4rpx solid rgba(100,180,255,0.18);
  border-top-color: #64b5f6;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-spinner .loading-text {
  margin-top: 20rpx;
  font-size: var(--font-caption);
}
/* dark */
.loading-spinner .loading-text { color: rgba(255,255,255,0.50); }
.theme-light .loading-spinner .loading-text { color: #999999; }
.theme-ocean .loading-spinner .loading-text { color: rgba(227,242,253,0.45); }

/* ================================================================
   Empty state
   ================================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state .empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-state .empty-text {
  font-size: var(--font-body);
  text-align: center;
}
/* dark */
.empty-state .empty-text { color: rgba(255,255,255,0.50); }
.theme-light .empty-state .empty-text { color: #999999; }
.theme-ocean .empty-state .empty-text { color: rgba(227,242,253,0.45); }

.empty-state .empty-hint {
  margin-top: 12rpx;
  font-size: var(--font-caption);
}
/* dark */
.empty-state .empty-hint { color: rgba(255,255,255,0.36); }
.theme-light .empty-state .empty-hint { color: #bbbbbb; }
.theme-ocean .empty-state .empty-hint { color: rgba(227,242,253,0.30); }

/* ================================================================
   List footer
   ================================================================ */
.list-footer {
  text-align: center;
  padding: 24rpx 0 40rpx;
  font-size: var(--font-caption);
}
/* dark */
.list-footer { color: rgba(255,255,255,0.50); }
.theme-light .list-footer { color: #999999; }
.theme-ocean .list-footer { color: rgba(227,242,253,0.45); }

/* ================================================================
   Safe area bottom padding
   ================================================================ */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
