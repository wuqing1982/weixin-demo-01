/* ================================================================
   Design Tokens — spacing, radius, font
   ================================================================ */
page {
  --space-xs:  8rpx;
  --space-sm:  16rpx;
  --space-md:  20rpx;
  --space-lg:  24rpx;
  --space-xl:  32rpx;
  --radius-sm:  12rpx;
  --radius-md:  16rpx;
  --radius-lg:  24rpx;
  --radius-pill: 999rpx;
  --font-title:   40rpx;
  --font-heading: 32rpx;
  --font-body:    28rpx;
  --font-caption: 24rpx;
  --font-badge:   22rpx;
  background: linear-gradient(180deg, #0e1514 0%, #141d1b 100%);
  color: #ffffff;
  min-height: 100%;
}

view, text, button, image, input, scroll-view, textarea {
  box-sizing: border-box;
}

/* ================================================================
   Dark theme (default) — 黑色 + 墨绿
   ================================================================ */
.page-root {
  min-height: 100vh;
  background: linear-gradient(180deg, #0e1514 0%, #141d1b 100%);
  color: #ffffff;
}

.card, .state-card {
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.12) !important;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.25);
}

.state-card {
  margin: 28rpx 20rpx 0;
  padding: 32rpx 28rpx;
  font-size: var(--font-body);
  text-align: center;
  color: rgba(255,255,255,0.72) !important;
}

.section-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: #ffffff !important;
}

.section-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-caption);
  color: rgba(255,255,255,0.65) !important;
}

/* ---- Buttons ---- */
.btn-primary, .btn-secondary, .btn-success, .btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 var(--space-xl);
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-primary::after, .btn-secondary::after, .btn-success::after, .btn-danger::after { border: 0; }
.btn-primary:active, .btn-secondary:active, .btn-success:active, .btn-danger:active { transform: scale(0.98); }
.btn-primary[disabled], .btn-secondary[disabled], .btn-success[disabled], .btn-danger[disabled] { opacity: 0.45; }

.btn-primary {
  border: 0 !important;
  background: linear-gradient(135deg, #2b8a68, #1c6f54) !important;
  color: #ffffff !important;
  font-weight: 600;
}

.btn-secondary {
  border: 1px solid rgba(255,255,255,0.20) !important;
  background: rgba(255,255,255,0.08) !important;
  color: #ffffff !important;
}

.btn-success {
  border: 0 !important;
  background: linear-gradient(135deg, #4ade80, #22c55e) !important;
  color: #ffffff !important;
  font-weight: 600;
}

.btn-danger {
  border: 0 !important;
  background: linear-gradient(135deg, #f87171, #ef4444) !important;
  color: #ffffff !important;
  font-weight: 600;
}

.btn-sm {
  height: 56rpx;
  font-size: var(--font-caption);
  padding: 0 var(--space-lg);
}

/* ---- Tags ---- */
.tag {
  display: inline-flex; align-items: center; height: 40rpx; padding: 0 16rpx;
  border-radius: var(--radius-pill); font-size: var(--font-badge);
}
.tag-primary   { background: rgba(43,138,104,0.18); color: #6ee7b0 !important; }
.tag-success   { background: rgba(74,222,128,0.18);  color: #6ee7a0 !important; }
.tag-warning   { background: rgba(251,191,36,0.18);  color: #fcd34d !important; }
.tag-danger    { background: rgba(248,113,113,0.18);  color: #fca5a5 !important; }

/* ---- Badges ---- */
.badge {
  display: inline-flex; align-items: center; justify-content: center;
  height: 36rpx; padding: 0 14rpx; border-radius: var(--radius-pill);
  font-size: var(--font-badge); font-weight: 600;
}
.badge-success { background: #4ade80; color: #0a0a0a !important; }
.badge-primary { background: #2b8a68; color: #ffffff !important; }
.badge-pending {
  background: rgba(255,255,255,0.10) !important;
  color: rgba(255,255,255,0.60) !important;
  border: 1px solid rgba(255,255,255,0.15) !important;
}

/* ---- Input ---- */
.input-field {
  border-radius: var(--radius-md); height: 80rpx; padding: 0 var(--space-lg);
  font-size: var(--font-body);
  background: rgba(255,255,255,0.10) !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
  color: #ffffff !important;
}

/* ---- Spinner ---- */
.loading-spinner { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 0; }
.spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.12); border-top-color: #2b8a68;
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 20rpx; font-size: var(--font-caption); color: rgba(255,255,255,0.45); }

/* ---- Empty state ---- */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 40rpx; }
.empty-icon { width: 160rpx; height: 160rpx; margin-bottom: 24rpx; opacity: 0.3; }
.empty-text { font-size: var(--font-body); text-align: center; color: rgba(255,255,255,0.45); }
.empty-hint { margin-top: 12rpx; font-size: var(--font-caption); color: rgba(255,255,255,0.30); }

.list-footer { text-align: center; padding: 24rpx 0 40rpx; font-size: var(--font-caption); color: rgba(255,255,255,0.40); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.container { min-height: 100vh; padding: 28rpx 24rpx 40rpx; }

/* ================================================================
   Theme: Light — 微信绿 + 白底
   所有选择器使用 .xxx.theme-light 组合选择器（同元素）
   ================================================================ */

/* Page background */
.page-root.theme-light {
  background: linear-gradient(180deg, #f5f6f8 0%, #ebedf0 100%) !important;
  color: #191919 !important;
}

/* Cards */
.card.theme-light,
.state-card.theme-light {
  background: #ffffff !important;
  border: 1px solid #e8e8e8 !important;
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08), 0 1rpx 4rpx rgba(0,0,0,0.04) !important;
}

.state-card.theme-light {
  color: #888888 !important;
}

/* Typography */
.section-title.theme-light {
  color: #1a1a1a !important;
}

.section-subtitle.theme-light {
  color: #888888 !important;
}

/* Buttons */
.btn-primary.theme-light {
  background: #07c160 !important;
  border-radius: 12rpx !important;
}

.btn-secondary.theme-light {
  background: #f5f5f5 !important;
  border-color: #dcdcdc !important;
  color: #333333 !important;
}

.btn-success.theme-light {
  background: #07c160 !important;
  border-radius: 12rpx !important;
}

.btn-danger.theme-light {
  background: #fa5151 !important;
  border-radius: 12rpx !important;
}

/* Tags */
.tag-primary.theme-light   { background: rgba(7,193,96,0.10);  color: #06ad56 !important; }
.tag-success.theme-light   { background: rgba(7,193,96,0.10);  color: #06ad56 !important; }
.tag-warning.theme-light   { background: rgba(237,106,12,0.10); color: #d46b08 !important; }
.tag-danger.theme-light    { background: rgba(250,81,81,0.10);  color: #cf1322 !important; }

/* Badges */
.badge-success.theme-light { background: #07c160 !important; color: #ffffff !important; }
.badge-primary.theme-light { background: #07c160 !important; color: #ffffff !important; }
.badge-pending.theme-light {
  background: #f0f0f2 !important;
  color: #888888 !important;
  border-color: #e0e0e0 !important;
}

/* Input */
.input-field.theme-light {
  background: #ffffff !important;
  border-color: #d9d9d9 !important;
  color: #333333 !important;
  border-radius: 12rpx !important;
}

/* Misc */
.spinner.theme-light {
  border-color: #e8e8e8;
  border-top-color: #07c160;
}
.loading-text.theme-light { color: #999999; }
.empty-text.theme-light { color: #999999; }
.empty-hint.theme-light { color: #bbbbbb; }
.list-footer.theme-light { color: #999999; }

/* ================================================================
   Theme: Ocean — 深海蓝 + 青色荧光
   所有选择器使用 .xxx.theme-ocean 组合选择器（同元素）
   ================================================================ */

/* Page background */
.page-root.theme-ocean {
  background: linear-gradient(180deg, #041526 0%, #0a2540 40%, #072038 100%) !important;
  color: #e3f2fd !important;
}

/* Cards */
.card.theme-ocean,
.state-card.theme-ocean {
  background: linear-gradient(180deg, rgba(30,80,160,0.28), rgba(20,60,120,0.18)) !important;
  border: 1px solid rgba(80,160,255,0.25) !important;
  border-radius: 24rpx !important;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.35), inset 0 1rpx 0 rgba(100,200,255,0.10) !important;
}

.state-card.theme-ocean {
  color: rgba(180,220,255,0.75) !important;
}

/* Typography */
.section-title.theme-ocean {
  color: #e8f4ff !important;
}

.section-subtitle.theme-ocean {
  color: rgba(180,220,255,0.65) !important;
}

/* Buttons */
.btn-primary.theme-ocean {
  background: linear-gradient(135deg, #00d4ff, #0099cc) !important;
  box-shadow: 0 8rpx 28rpx rgba(0,180,255,0.35) !important;
}

.btn-secondary.theme-ocean {
  background: rgba(40,100,200,0.15) !important;
  border-color: rgba(80,180,255,0.30) !important;
  color: #b0d8ff !important;
}

.btn-success.theme-ocean {
  background: linear-gradient(135deg, #00e5a0, #00c48c) !important;
  box-shadow: 0 8rpx 28rpx rgba(0,200,160,0.30) !important;
}

.btn-danger.theme-ocean {
  background: linear-gradient(135deg, #ff6b6b, #ee4444) !important;
  box-shadow: 0 8rpx 28rpx rgba(255,80,80,0.30) !important;
}

/* Tags */
.tag-primary.theme-ocean   { background: rgba(0,200,255,0.15);  color: #66d9ff !important; }
.tag-success.theme-ocean   { background: rgba(0,224,180,0.15);  color: #5cf5c8 !important; }
.tag-warning.theme-ocean   { background: rgba(255,183,77,0.15); color: #ffb74d !important; }
.tag-danger.theme-ocean    { background: rgba(255,100,100,0.15); color: #ff8a8a !important; }

/* Badges */
.badge-success.theme-ocean { background: #00d4aa !important; color: #041526 !important; }
.badge-primary.theme-ocean { background: #00b8ff !important; color: #041526 !important; }
.badge-pending.theme-ocean {
  background: rgba(40,100,200,0.20) !important;
  color: rgba(180,220,255,0.65) !important;
  border-color: rgba(80,160,255,0.20) !important;
}

/* Input */
.input-field.theme-ocean {
  background: rgba(20,60,120,0.30) !important;
  border-color: rgba(80,160,255,0.25) !important;
  color: #e3f2fd !important;
}

/* Misc */
.spinner.theme-ocean {
  border-color: rgba(80,160,255,0.20);
  border-top-color: #00b8ff;
}
.loading-text.theme-ocean { color: rgba(180,220,255,0.50); }
.empty-text.theme-ocean { color: rgba(180,220,255,0.50); }
.empty-hint.theme-ocean { color: rgba(180,220,255,0.35); }
.list-footer.theme-ocean { color: rgba(180,220,255,0.40); }

/* ================================================================
   Theme: Notion — 暖灰纸张 + 墨蓝强调
   基于 Notion 设计规范，纯亮色主题
   ================================================================ */

/* Page background */
.page-root.theme-notion {
  background: linear-gradient(180deg, #ffffff 0%, #f6f5f4 100%) !important;
  color: rgba(0,0,0,0.95) !important;
}

/* Cards */
.card.theme-notion,
.state-card.theme-notion {
  background: #ffffff !important;
  border: 1px solid rgba(0,0,0,0.1) !important;
  border-radius: 24rpx !important;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04), 0 1rpx 4rpx rgba(0,0,0,0.02) !important;
}

.state-card.theme-notion {
  color: #615d59 !important;
}

/* Typography */
.section-title.theme-notion {
  color: rgba(0,0,0,0.95) !important;
}

.section-subtitle.theme-notion {
  color: #615d59 !important;
}

/* Buttons */
.btn-primary.theme-notion {
  background: #0075de !important;
  border-radius: 8rpx !important;
}

.btn-secondary.theme-notion {
  background: rgba(0,0,0,0.05) !important;
  border-color: rgba(0,0,0,0.1) !important;
  color: rgba(0,0,0,0.95) !important;
}

.btn-success.theme-notion {
  background: #1aae39 !important;
  border-radius: 8rpx !important;
}

.btn-danger.theme-notion {
  background: #dd5b00 !important;
  border-radius: 8rpx !important;
}

/* Tags */
.tag-primary.theme-notion   { background: #f2f9ff; color: #097fe8 !important; }
.tag-success.theme-notion   { background: rgba(26,174,57,0.10); color: #1aae39 !important; }
.tag-warning.theme-notion   { background: rgba(221,91,0,0.10); color: #dd5b00 !important; }
.tag-danger.theme-notion    { background: rgba(221,91,0,0.10); color: #dd5b00 !important; }

/* Badges */
.badge-success.theme-notion { background: #1aae39 !important; color: #ffffff !important; }
.badge-primary.theme-notion { background: #0075de !important; color: #ffffff !important; }
.badge-pending.theme-notion {
  background: #f6f5f4 !important;
  color: #615d59 !important;
  border-color: rgba(0,0,0,0.1) !important;
}

/* Input */
.input-field.theme-notion {
  background: #ffffff !important;
  border-color: #dddddd !important;
  color: rgba(0,0,0,0.95) !important;
  border-radius: 8rpx !important;
}

/* Misc */
.spinner.theme-notion {
  border-color: rgba(0,0,0,0.1);
  border-top-color: #0075de;
}
.loading-text.theme-notion { color: #a39e98; }
.empty-text.theme-notion { color: #a39e98; }
.empty-hint.theme-notion { color: rgba(0,0,0,0.25); }
.list-footer.theme-notion { color: #a39e98; }
